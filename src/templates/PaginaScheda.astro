---
/*
 * Template "scheda": hero con foto, uno o piu' blocchi media+testo alternati (titolo, foto o
 * video, durata, "cosa portare", intensita') e le sedi in cui si svolge l'attivita'. Serve le
 * schede corso (tipo "corso") e le pagine servizio (tipo "servizio": quelle con blocchi di solo
 * testo, come il nuoto neonatale). I contenuti arrivano dal JSON della pagina
 * (src/data/pagine/<slug>.json), estratto dal sito WordPress originale.
 *
 * Le sedi: di norma un unico box in fondo con quelle della pagina ("sedi"). Se i blocchi hanno
 * ciascuno le proprie ("sedi" dentro il blocco, es. X-Room solo a Meda e X-Space solo a Camuzzago)
 * il box sta sotto ogni blocco, con le sole sedi di quel blocco, e quello finale non c'e'.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CourseBlock from '../components/CourseBlock.astro';
import SediAttivita from '../components/SediAttivita.astro';
import FasiPercorso from '../components/FasiPercorso.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { domandeFrequenti, grafo } from '../lib/jsonld';
import { sedi, formUrl } from '../data/site';

interface Pulsante {
	testo: string;
	href: string;
	/** Si apre in un'altra scheda (i moduli n8n). */
	esterno?: boolean;
}

interface Props {
	pagina: {
		tipo: 'corso' | 'servizio';
		slug: string;
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; immagine: string; pulsanti?: Pulsante[]; badge?: string };
		blocchi: any[];
		/** Assente nelle pagine che sul sito originale non mostrano le FAQ (eliminate). */
		faq?: { domanda: string; risposta: string | null }[];
		/** Le FAQ ci sono nei dati ma sul sito originale sono nascoste: non si mostrano. */
		faqNascoste?: boolean;
		/** Etichetta delle sedi se diversa da quella di default (es. Personal Training, Medical Center). */
		sediEtichetta?: string;
		/** Sedi in cui si svolge l'attivita' (slug): sezione finale con le card delle sedi. */
		sedi?: ('meda' | 'camuzzago')[];
	};
}

const { pagina } = Astro.props;

// Le schede hanno sempre "Prova ora" (modulo n8n) e il planning.
const pulsanti: Pulsante[] =
	pagina.hero.pulsanti ??
	[
		{ testo: 'Prova ora', href: formUrl('prova', pagina.slug), esterno: true },
		{ testo: 'Planning settimanale', href: '/orari' },
	];

// Nell'ordine indicato nei dati (come sul sito originale), non in quello di site.ts.
const sediDi = (slugs: string[] = []) => slugs.map((slug) => sedi.find((s) => s.slug === slug)).filter((s) => s !== undefined);
const sediAttivita = sediDi(pagina.sedi);
const sediPerBlocco = pagina.blocchi.some((b) => b.sedi);

// Percorso in fasi (nuoto neonatale): i blocchi "PRIMA FASE ...", "SECONDA FASE ..." diventano un'unica
// sezione a colonne. Se il blocco subito prima e' di solo testo ("Il Percorso in 3 fasi") ne e' l'intestazione.
const eFase = (b: any) => /^(prima|seconda|terza|quarta|quinta)\s+fase\b/i.test((b?.titolo ?? '').trim());
const indiciFasi = pagina.blocchi.flatMap((b, i) => (eFase(b) ? [i] : []));
const haFasi = indiciFasi.length >= 2;
const ultimaFase = haFasi ? indiciFasi[indiciFasi.length - 1] : -1;
const bloccoPrima = haFasi ? pagina.blocchi[indiciFasi[0] - 1] : undefined;
const introFasi = bloccoPrima && !bloccoPrima.immagini?.length && !bloccoPrima.video ? bloccoPrima : undefined;
const inizioFasi = haFasi ? indiciFasi[0] - (introFasi ? 1 : 0) : -1;

// Un solo blocco "vero" (le fasi non contano): le sedi della pagina stanno li', a sinistra, come nelle schede
// con un blocco solo; con piu' blocchi stanno in una fascia centrata in fondo.
const bloccoVero = (i: number) => !(haFasi && i >= inizioFasi && i <= ultimaFase);
const soloUnBlocco = pagina.blocchi.filter((_, i) => bloccoVero(i)).length === 1;

// Una scheda corso senza video usa la foto della pagina; le pagine "servizio" no.
const sfondoSenzaMedia = pagina.tipo === 'corso' ? pagina.hero.immagine : undefined;

// Le FAQ si mostrano (e si dichiarano a Google) solo dove sono visibili anche sul sito originale.
const faqVisibili = pagina.faqNascoste ? [] : (pagina.faq ?? []);
const faqJsonLd = domandeFrequenti(faqVisibili);

// Colori delle sezioni, dall'alto in basso: nero e giallo alternati (come le pagine sede), sempre a partire
// dal nero perche' la hero sfuma nel nero. Le FAQ e la fascia delle sedi stanno sul nero. Dopo l'ultima
// sezione c'e' la CTA gialla del footer: se l'ultima e' nera, in fondo c'e' lo sfumo verso il giallo.
const voci: ({ k: 'blocco'; i: number } | { k: 'fasi' })[] = [];
pagina.blocchi.forEach((_, i) => {
	if (haFasi && i >= inizioFasi && i <= ultimaFase) {
		if (i === inizioFasi) voci.push({ k: 'fasi' });
		return;
	}
	voci.push({ k: 'blocco', i });
});
const eAccento = (n: number) => n % 2 === 1;
const faqPresenti = faqVisibili.some((f) => f.risposta);
const fasciaSedi = !sediPerBlocco && !soloUnBlocco && sediAttivita.length > 0;
const toni: ('nero' | 'accento')[] = [...voci.map((_, n) => (eAccento(n) ? 'accento' : 'nero') as 'nero' | 'accento'), ...(faqPresenti ? ['nero' as const] : []), ...(fasciaSedi ? ['nero' as const] : [])];
const dopo = (n: number): 'nero' | 'accento' => toni[n + 1] ?? 'accento';
const dopoSfumo = (n: number) => n > 0 && toni[n - 1] !== toni[n];
const nFaq = voci.length;
const nFascia = voci.length + (faqPresenti ? 1 : 0);
---

<Layout title={pagina.seo.title} description={pagina.seo.description} headerTone="overlay" ogSlug={pagina.slug} jsonLd={faqJsonLd ? grafo(faqJsonLd) : undefined}>
	<PageHero image={pagina.hero.immagine} title={pagina.hero.titolo} words={pagina.hero.parole} eyebrow={pagina.hero.badge}>
		{
			pulsanti.map((p, i) => (
				<a
					class:list={['btn', 'btn--lg', i === 0 ? 'btn--pillola' : 'btn--light']}
					href={p.href}
					target={p.esterno ? '_blank' : undefined}
					rel={p.esterno ? 'noopener' : undefined}
				>
					{p.testo}
				</a>
			))
		}
	</PageHero>

	{
		voci.map((voce, n) => {
			if (voce.k === 'fasi') {
				return (
					<FasiPercorso
						titolo={introFasi?.titolo || 'Il percorso in fasi'}
						introHtml={introFasi?.descrizioneHtml}
						fasi={indiciFasi.map((k) => ({ titolo: pagina.blocchi[k].titolo, html: pagina.blocchi[k].descrizioneHtml }))}
						tone={eAccento(n) ? 'accento' : 'dark'}
						sfumoA={dopo(n)}
						dopoSfumo={dopoSfumo(n)}
					/>
				);
			}
			const blocco = pagina.blocchi[voce.i];
			// Sedi nel blocco: le sue (se le indica) o, con un solo blocco, quelle della pagina.
			const sediBlocco = blocco.sedi ? sediDi(blocco.sedi) : soloUnBlocco ? sediAttivita : [];
			return (
				<CourseBlock blocco={blocco} fallbackImage={sfondoSenzaMedia} reverse={n % 2 === 1} tone={eAccento(n) ? 'accento' : 'dark'} sfumoA={dopo(n)} dopoSfumo={dopoSfumo(n)}>
					<SediAttivita sedi={sediBlocco} etichetta={pagina.sediEtichetta} />
				</CourseBlock>
			);
		})
	}

	<FaqAccordion faq={faqVisibili} sfumoA={faqPresenti && dopo(nFaq) === 'accento' ? 'accento' : undefined} dopoSfumo={faqPresenti && dopoSfumo(nFaq)} />

	{
		fasciaSedi && (
			<section
				class:list={['sedi-fascia', 'sez', 'on-dark', 'sfuma', { 'dopo-sfumo': dopoSfumo(nFascia) }]}
				style="--da:var(--bg-dark);--a:var(--accent)"
				aria-label="Sedi dell'attività"
			>
				<div class="container-wide">
					<SediAttivita sedi={sediAttivita} centrato etichetta={pagina.sediEtichetta} />
				</div>
			</section>
		)
	}
</Layout>

<style>
	/* Pagine con piu' attivita' nelle stesse sedi: una fascia in fondo, centrata, con la riga delle sedi. */
	.sedi-fascia {
		padding-block: var(--sez-pt, clamp(32px, 4vw, 56px)) var(--sez-pb, clamp(40px, 5vw, 64px));
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.sedi-fascia :global(.dove) {
		margin-top: 0;
	}
</style>
