---
/*
 * Template "elenco": la pagina dei Corsi Fitness. Hero, introduzione e una griglia di card
 * (una per corso, con la foto della card originale e il collegamento alla scheda) seguita
 * dalle domande frequenti. Il vecchio sito non aveva descrizioni per le card.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import IntroTitolo from '../components/IntroTitolo.astro';
import ActivityGrid from '../components/ActivityGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { domandeFrequenti, grafo } from '../lib/jsonld';
import { formUrl } from '../data/site';

interface Props {
	pagina: {
		slug: string;
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; immagine: string; badge?: string };
		introHtml: string;
		corsi: { titolo: string; href: string | null; immagine: string }[];
		/** Assente nelle pagine che sul sito originale non mostrano le FAQ (eliminate). */
		faq?: { domanda: string; risposta: string | null }[];
		/** Le FAQ ci sono nei dati ma sul sito originale sono nascoste: non si mostrano. */
		faqNascoste?: boolean;
	};
}

const { pagina } = Astro.props;
const card = pagina.corsi.filter((c) => c.href).map((c) => ({ href: c.href as string, image: c.immagine, title: c.titolo }));

// Le FAQ si mostrano (e si dichiarano a Google) solo dove sono visibili anche sul sito originale.
const faqVisibili = pagina.faqNascoste ? [] : (pagina.faq ?? []);
const faqJsonLd = domandeFrequenti(faqVisibili);
// Sezione nera in fondo: sfumo verso il giallo del footer (della CTA finale) o, se ci sono le FAQ, e' la FAQ a farlo.
const faqPresenti = faqVisibili.some((f) => f.risposta);
---

<Layout title={pagina.seo.title} description={pagina.seo.description} headerTone="overlay" ogSlug={pagina.slug} jsonLd={faqJsonLd ? grafo(faqJsonLd) : undefined}>
	<PageHero image={pagina.hero.immagine} title={pagina.hero.titolo} words={pagina.hero.parole}>
		<a class="btn btn--pillola btn--lg" href={formUrl('prova', pagina.slug)}>Prova ora</a>
		<a class="btn btn--light btn--lg" href="/orari">Planning settimanale</a>
	</PageHero>

	<IntroTitolo titolo={pagina.hero.badge ?? pagina.nome} html={pagina.introHtml} />

	<section
		class:list={['elenco', 'sez', 'on-dark', { sfuma: !faqPresenti }]}
		style={faqPresenti ? undefined : '--da:var(--bg-dark);--a:var(--accent)'}
		aria-label="I nostri corsi"
	>
		<ActivityGrid items={card} columns={3} gapTop={0} />
	</section>

	<FaqAccordion faq={faqVisibili} sfumoA={faqPresenti ? 'accento' : undefined} />
</Layout>

<style>
	.elenco {
		padding-block: var(--sez-pt, 8px) var(--sez-pb, 56px);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	@media (max-width: 900px) {
		.elenco :global(.grid) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.elenco :global(.grid) {
			grid-template-columns: 1fr;
		}
	}
</style>
