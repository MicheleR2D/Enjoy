---
/*
 * Template "sede": la pagina di Meda o di Camuzzago. Hero, orari di apertura, descrizione della
 * struttura, un blocco per ogni ambiente (palestra, sale corsi, piscine, thermarium...) con le
 * foto in carosello e le attivita' che si svolgono nella sede. I contenuti arrivano dal JSON
 * della pagina (src/data/pagine/<slug>.json), estratto dal sito WordPress originale.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CourseBlock from '../components/CourseBlock.astro';
import ActivityGrid from '../components/ActivityGrid.astro';
import Cartello from '../components/Cartello.astro';
import NumeriGrandi from '../components/NumeriGrandi.astro';
import IconaMetodo from '../components/IconaMetodo.astro';
import { sedi, mapsDirectionsUrl, formUrl } from '../data/site';
import { luogo, grafo } from '../lib/jsonld';
import { inSchede } from '../lib/schede.js';

interface Props {
	pagina: {
		slug: 'meda' | 'camuzzago';
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; sottotitolo?: string; immagine: string; alt?: string; video?: { id: string; inizio?: number; fine?: number } };
		orari: { titolo: string | null; html: string | null };
		struttura: { titolo: string; sottotitolo: string; testi: string[] };
		/** Tre numeri grandi sul giallo (valore, suffisso "+", "m", "m²"... ed etichetta), presi dai testi della pagina. */
		numeri?: { valore: number; suffisso: string; etichetta: string }[];
		ambienti: { titolo: string; immagini: string[]; html: string }[];
		attivita: { titolo: string; card: { titolo: string; href: string | null; immagine: string }[] };
	};
}

const { pagina } = Astro.props;
const sede = sedi.find((s) => s.slug === pagina.slug)!;
const card = pagina.attivita.card.filter((c) => c.href).map((c) => ({ href: c.href as string, image: c.immagine, title: c.titolo }));

// Il blocco "ambiente" e' quello delle schede: titolo, foto (carosello se piu' d'una) e testo.
const blocchi = pagina.ambienti.map((a) => ({
	titolo: a.titolo,
	sottotitolo: null,
	// Testo alternativo delle foto dell'ambiente (es. "Piscine di Enjoy Club Camuzzago")
	alt: `${a.titolo} di Enjoy Club ${sede.nome}`,
	descrizioneHtml: a.html,
	immagini: a.immagini,
	dettagli: [],
	portareTitolo: null,
	portare: [],
	intensita: [],
}));

// Testo di ogni ambiente diviso in schede (card a scorrimento): sotto-aree con titolo o paragrafi brevi, stesse parole.
const schedeAmbienti = pagina.ambienti.map((a) => inSchede(a.html));

// Titolo su tre righe, con la parte centrale in giallo ("Scegli / ogni giorno / il tuo benessere").
const titoloOrari = pagina.orari.titolo ?? 'Scegli ogni giorno il tuo benessere';
const partiTitolo = titoloOrari.match(/^(\S+) (\S+ \S+) (.+)$/);
// Orari: una riga per fascia ("Lunedi' - ... - Venerdi' dalle 7.00 alle 22.30"): giorni sopra, ore sotto. Si taglia dove
// iniziano le ore ("dalle 7.00" oppure "7.00"); se non si riconosce il taglio la riga resta intera.
const righeOrari = (pagina.orari.html ?? '')
	.split(/<br\s*\/?>/i)
	.map((r) => r.replace(/<[^>]*>/g, '').trim())
	.filter(Boolean)
	.map((r) => {
		const m = r.match(/^(.*?)\s+((?:dalle\s+)?\d.*)$/i);
		return m ? { giorni: m[1], ore: m[2] } : { giorni: r, ore: '' };
	});

// Titoli dei due cartelli della struttura: frasi gia' presenti nei paragrafi (nei testi non ci sono grassetti
// da cui ricavarli). DA APPROVARE.
const titoliCartelli: Record<string, string[]> = {
	meda: ['Design, benessere e funzionalità', 'Il vero gioiello del centro'],
	camuzzago: ['Un’oasi di benessere', 'Il fiore all’occhiello'],
};

// Dati chiave dei paragrafi della Struttura: frasi gia' presenti nel testo (si evidenziano, le parole restano le stesse).
const datiChiave: Record<string, string[]> = {
	meda: ['2800 m²', 'oltre 100 attività settimanali', 'piscina panoramica da 25 metri con 4 corsie', '29 gradi'],
	camuzzago: ['oltre 500 m²', 'supera i 90 corsi settimanali', 'piscina coperta da 25 metri con 6 corsie'],
};
const evidenzia = (html: string, frasi: string[] = []) => frasi.reduce((h, f) => h.replace(f, `<strong>${f}</strong>`), html);

// Colori delle sezioni dopo la zona gialla: ambienti alternati (nero, giallo...), poi "le attivita'" sul nero.
// Tra una e l'altra c'e' sempre lo sfumo; dopo l'ultima sezione c'e' la CTA gialla del footer.
const eAccento = (i: number) => i % 2 === 1;
const nBlocchi = blocchi.length;
const dopoBlocco = (i: number): 'nero' | 'accento' => (i + 1 < nBlocchi ? (eAccento(i + 1) ? 'accento' : 'nero') : card.length > 0 ? 'nero' : 'accento');
const provincia = sede.citta.match(/\((\w+)\)/)?.[1];
---

<Layout title={pagina.seo.title} description={pagina.seo.description} headerTone="overlay" ogSlug={pagina.slug} jsonLd={grafo(luogo(sede, pagina.hero.immagine))}>
	<PageHero image={pagina.hero.immagine} imageAlt={pagina.hero.alt} title={pagina.hero.titolo} sottotitolo={pagina.hero.sottotitolo || undefined} words={pagina.hero.parole} video={pagina.hero.video}>
		<a class="btn btn--pillola btn--lg" href={formUrl('prova', `Sede-${pagina.slug}`)} target="_blank" rel="noopener">Prova ora</a>
		<a class="btn btn--light btn--lg" href={formUrl('contatto', `Hero-${pagina.slug}`)} target="_blank" rel="noopener">
			Richiedi informazioni
		</a>
	</PageHero>

	<section class="orari-sede on-dark">
		<div class="orari-sede__grid container-wide">
			<div class="orari-sede__intro">
				<h2 class="orari-sede__title" data-anim="from-left">
					{
						partiTitolo ? (
							<>
								<span>{partiTitolo[1]}</span>
								<span class="orari-sede__accento">{partiTitolo[2]}</span>
								<span>{partiTitolo[3]}</span>
							</>
						) : (
							titoloOrari
						)
					}
				</h2>
			</div>
			<div class="orari-sede__col" data-anim="from-right" data-anim-delay="80">
				<div class="orari-sede__orari">
					{
						righeOrari.map((r) => (
							<p class="orari-sede__riga">
								<span class="orari-sede__giorni">{r.giorni}</span>{' '}
								{r.ore && <span class="orari-sede__ore">{r.ore}</span>}
							</p>
						))
					}
				</div>
				<p class="orari-sede__dove">
					<a href={mapsDirectionsUrl(sede)} target="_blank" rel="noopener">
						<span>{sede.via}</span><span>{sede.nome}</span>{provincia && <span>{provincia}</span>}
					</a>
				</p>
			</div>
		</div>
	</section>

	<section
		class="sede-gialla sez sfuma sfuma-su"
		style="--da:var(--accent);--a:var(--bg-dark);--da-su:var(--bg-dark);--a-su:var(--accent)"
	>
		<div class="sede-gialla__inner container-wide">
			<header class="sede-gialla__testata">
				<h2 class="sede-gialla__titolo" data-anim="up">{pagina.struttura.titolo}</h2>
				<p class="sede-gialla__sub" data-anim="up" data-anim-delay="80">{pagina.struttura.sottotitolo}</p>
			</header>

			<div class="sede-gialla__cartelli">
				{
					pagina.struttura.testi.map((t, i) => (
						<Cartello titolo={titoliCartelli[pagina.slug]?.[i] ?? pagina.struttura.titolo} lato={i % 2 === 0 ? 'sinistra' : 'destra'}>
							<div set:html={evidenzia(t.startsWith('<') ? t : `<p>${t}</p>`, datiChiave[pagina.slug])} />
						</Cartello>
					))
				}
			</div>

			{pagina.numeri && pagina.numeri.length > 0 && <NumeriGrandi numeri={pagina.numeri} />}
		</div>
	</section>

	{
		blocchi.map((blocco, i) => (
			<CourseBlock blocco={blocco} reverse={i % 2 === 1} tone={eAccento(i) ? 'accento' : 'dark'} sfumoA={dopoBlocco(i)} dopoSfumo fotoCentro schede={schedeAmbienti[i]} />
		))
	}

	{
		card.length > 0 && (
			<section
				class:list={['attivita-sede', 'sez', 'on-dark', 'sfuma', { 'dopo-sfumo': eAccento(nBlocchi - 1) }]}
				style="--da:var(--bg-dark);--a:var(--accent)"
			>
				<SectionTitle tone="dark-bg" gap={0}>
					{pagina.attivita.titolo}
				</SectionTitle>
				<ActivityGrid items={card} columns={card.length < 3 ? card.length : 3} gapTop={35} />
			</section>
		)
	}
</Layout>

<style>
	/* Zona gialla (struttura, numeri): come la storia in home, con cartelli neri che entrano di lato.
	   Il ritaglio orizzontale evita che un cartello, fuori schermo, allarghi la pagina. */
	.sede-gialla {
		overflow-x: clip;
		padding-block: var(--sez-pt, clamp(56px, 7vw, 96px)) var(--sez-pb, clamp(56px, 7vw, 96px));
		background: var(--accent);
		color: var(--on-accent);
	}

	.sede-gialla__inner {
		display: grid;
		gap: 48px;
	}

	/* Orari: sezione nera come prima (titolo bianco su tre righe con la parte centrale gialla, orari a destra in righe:
	   giorni e ore; niente linee gialle). Sfondo come la fine della hero (--bg-dark); in fondo 36px pieni prima dello
	   sfumo verso la zona gialla. */
	.orari-sede {
		padding-block: clamp(32px, 4.5vw, 56px) 36px;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.orari-sede__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		column-gap: clamp(24px, 5vw, 72px);
		align-items: start;
	}

	.orari-sede__title {
		margin: 0;
		font-size: clamp(2.2rem, 4vw, 3.5rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-transform: none;
		color: var(--text-on-dark);
	}

	.orari-sede__title span {
		display: block;
	}

	.orari-sede__accento {
		color: var(--accent);
	}

	/* Una riga per fascia: giorni (bianco, leggero) e sotto le ore (giallo, piu' marcato). */
	.orari-sede__orari {
		display: grid;
		gap: clamp(14px, 2vw, 22px);
	}

	.orari-sede__riga {
		margin: 0;
		text-transform: uppercase;
	}

	.orari-sede__giorni {
		display: block;
		font-size: clamp(0.95rem, 1.4vw, 1.2rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		line-height: 1.35;
	}

	.orari-sede__ore {
		display: block;
		margin-top: 2px;
		font-size: clamp(1.35rem, 2.2vw, 1.8rem);
		font-weight: 800;
		line-height: 1.2;
		color: var(--accent);
	}

	.orari-sede__dove {
		margin: clamp(24px, 3vw, 36px) 0 0;
		font-size: clamp(1.1rem, 1.7vw, 1.45rem);
		font-weight: 300;
		text-transform: uppercase;
	}

	.orari-sede__dove a {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		min-height: 44px;
		color: var(--accent);
		text-decoration: none;
	}

	.orari-sede__dove a:hover {
		text-decoration: underline;
	}

	.orari-sede__dove span + span::before {
		content: '|';
		margin-inline: 0.5em;
	}

	.sede-gialla__testata {
		display: grid;
		gap: 12px;
		margin-bottom: -24px;
	}

	.sede-gialla__titolo {
		margin: 0;
		font-size: clamp(2.2rem, 4.4vw, 3.5rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: var(--on-accent);
	}

	.sede-gialla__sub {
		margin: 0;
		font-size: var(--text-md);
		font-style: italic;
		font-weight: 500;
		line-height: 1.4;
		color: var(--on-accent);
	}

	/* Dati chiave nei paragrafi della struttura: in giallo nel cartello nero (senza animazione). */
	.sede-gialla__cartelli :global(strong) {
		color: var(--accent);
	}

	.sede-gialla__cartelli {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 20px clamp(20px, 3vw, 40px);
	}

	.attivita-sede {
		padding-block: var(--sez-pt, 56px) var(--sez-pb, 56px);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	@media (max-width: 900px) {
		.orari-sede__grid {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 24px;
		}

		.sede-gialla__cartelli {
			grid-template-columns: minmax(0, 1fr);
		}

		/* Su telefono: 20px tra le card della stessa zona, 48 tra i gruppi (orari, testata, numeri). */
		.sede-gialla__testata {
			margin-bottom: -28px;
		}

		.attivita-sede :global(.grid) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.attivita-sede :global(.grid) {
			grid-template-columns: 1fr;
		}
	}
</style>
