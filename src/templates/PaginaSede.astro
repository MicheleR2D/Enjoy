---
/*
 * Template "sede": la pagina di Meda o di Camuzzago. Hero, orari di apertura, descrizione della
 * struttura, un blocco per ogni ambiente (palestra, sale corsi, piscine, thermarium...) con le
 * foto in carosello e le attivita' che si svolgono nella sede. I contenuti arrivano dal JSON
 * della pagina (src/data/pagine/<slug>.json), estratto dal sito WordPress originale.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import IntroTitolo from '../components/IntroTitolo.astro';
import SectionTitle from '../components/SectionTitle.astro';
import CourseBlock from '../components/CourseBlock.astro';
import ActivityGrid from '../components/ActivityGrid.astro';
import { sedi, indirizzoCompleto, mapsDirectionsUrl, formUrl } from '../data/site';

interface Props {
	pagina: {
		slug: 'meda' | 'camuzzago';
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; sottotitolo?: string; immagine: string };
		orari: { titolo: string | null; html: string | null };
		struttura: { titolo: string; sottotitolo: string; testi: string[] };
		ambienti: { titolo: string; immagini: string[]; html: string }[];
		attivita: { titolo: string; card: { titolo: string; href: string | null; immagine: string }[] };
	};
}

const { pagina } = Astro.props;
const sede = sedi.find((s) => s.slug === pagina.slug)!;
const card = pagina.attivita.card.filter((c) => c.href).map((c) => ({ href: c.href as string, image: c.immagine, title: c.titolo }));

// Il blocco "ambiente" e' quello delle schede: titolo, foto (carosello se piu' d'una) e testo.
const blocchi = pagina.ambienti.map((a) => ({
	titolo: a.titolo,
	sottotitolo: null,
	descrizioneHtml: a.html,
	immagini: a.immagini,
	dettagli: [],
	portareTitolo: null,
	portare: [],
	intensita: [],
}));

// Introduzione: la frase di apertura (che parla della zona) e gli orari.
const introHtml = [
	pagina.hero.sottotitolo ? `<p><strong>${pagina.hero.sottotitolo}</strong></p>` : '',
	pagina.orari.html ? `<p>${pagina.orari.html}</p>` : '',
].join('');
---

<Layout title={pagina.seo.title} description={pagina.seo.description} headerTone="overlay">
	<PageHero image={pagina.hero.immagine} title={pagina.hero.titolo} words={pagina.hero.parole}>
		<a class="btn btn--lg" href={formUrl('prova', `Sede-${pagina.slug}`)} target="_blank" rel="noopener">Prova ora</a>
		<a class="btn btn--light btn--lg" href={formUrl('contatto', `Hero-${pagina.slug}`)} target="_blank" rel="noopener">
			Richiedi informazioni
		</a>
	</PageHero>

	<IntroTitolo titolo={pagina.orari.titolo ?? 'Scegli ogni giorno il tuo benessere'} html={introHtml}>
		<p class="dove">
			{indirizzoCompleto(sede)} ·
			<a href={sede.telefonoHref}>{sede.telefono}</a>
			·
			<a href={mapsDirectionsUrl(sede)} target="_blank" rel="noopener">Indicazioni</a>
		</p>
	</IntroTitolo>

	<IntroTitolo titolo={pagina.struttura.titolo} html={`<p><strong>${pagina.struttura.sottotitolo}</strong></p>${pagina.struttura.testi.join('')}`} />

	{
		blocchi.map((blocco, i) => (
			<CourseBlock blocco={blocco} reverse={i % 2 === 1} tone={i % 2 === 1 ? 'accento' : 'dark'} />
		))
	}

	{
		card.length > 0 && (
			<section class="attivita-sede on-dark">
				<SectionTitle tone="dark-bg" gap={0}>
					{pagina.attivita.titolo}
				</SectionTitle>
				<ActivityGrid items={card} columns={card.length < 3 ? card.length : 3} gapTop={35} />
			</section>
		)
	}
</Layout>

<style>
	.dove {
		margin: 24px 0 0;
		font-size: var(--text-sm);
		color: var(--text-muted-on-dark);
	}

	.dove a {
		color: var(--text-on-dark);
	}

	.dove a:hover {
		color: var(--accent);
	}

	.attivita-sede {
		padding-block: 56px;
		background: var(--bg-dark-deep);
		color: var(--text-on-dark);
	}

	@media (max-width: 900px) {
		.attivita-sede :global(.grid) {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.attivita-sede :global(.grid) {
			grid-template-columns: 1fr;
		}
	}
</style>
