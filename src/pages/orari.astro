---
/*
 * Planning orari: i corsi giorno per giorno, con la scelta della sede. Struttura come la pagina
 * orari di Body Energie (tab della sede e dei giorni, filtro, pdf scaricabile). I dati arrivano dai
 * PDF dei planning (src/data/planning-sedi.json); testo introduttivo e SEO da orari-pagina.json,
 * estratti dal sito WordPress originale.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import IntroTitolo from '../components/IntroTitolo.astro';
import PlanningSedi from '../components/PlanningSedi.astro';
import orari from '../data/orari-pagina.json';
import { formUrl } from '../data/site';

const testo = orari.intro.join('');
const fotoHero = orari.hero.immagine ?? '/wp-content/uploads/2025/06/Gym-Floor-Camuzzago-3-scaled.jpg';
---

<Layout title={orari.seo.title} description={orari.seo.description} headerTone="overlay">
	<PageHero image={fotoHero} title={orari.hero.titolo} words={orari.hero.parole}>
		<a class="btn btn--lg" href={formUrl('prova', 'Orari')} target="_blank" rel="noopener">Prova ora</a>
	</PageHero>

	<IntroTitolo titolo="Pianifica la tua routine" html={testo} />

	<section class="orari on-dark" aria-label="Planning dei corsi">
		<div class="container-wide">
			<PlanningSedi />

			<ul class="orari__note">
				<li>Le sale aprono 10 minuti dopo l'apertura e chiudono 15 minuti prima della chiusura. La piscina apre 10 minuti dopo l'apertura e chiude 30 minuti prima della chiusura.</li>
				<li>I corsi sono a numero chiuso e si prenotano a partire da 3 giorni prima del giorno del corso, dalla app Technogym, dal totem o in reception.</li>
				<li>In certi orari le corsie del nuoto libero non sono disponibili.</li>
				<li>La direzione si riserva la facoltà di modificare orari di apertura e chiusura, la programmazione dei corsi e quella degli istruttori per esigenze organizzative.</li>
				<li>Camuzzago: ogni corso viene svolto con un minimo di 3 persone.</li>
			</ul>
		</div>
	</section>
</Layout>

<style>
	.orari {
		padding-block: clamp(32px, 4.5vw, 56px) clamp(48px, 6vw, 80px);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.orari__note {
		display: grid;
		gap: 8px;
		max-width: 60rem;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.orari__note li {
		position: relative;
		padding-left: 1.4em;
	}

	.orari__note li::before {
		content: '';
		position: absolute;
		left: 0.15em;
		top: 0.55em;
		width: 0.4em;
		height: 0.4em;
		background: var(--accent);
	}
</style>
