---
/*
 * Home di Enjoy Club. Testi e foto vengono da src/data/home.json, estratto dalla home di
 * WordPress/Elementor con scripts/migrazione/normalizza-home.mjs; qui si disegna il layout.
 */
import Layout from '../layouts/Layout.astro';
import ActivityGrid from '../components/ActivityGrid.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Img from '../components/Img.astro';
import IconaMetodo from '../components/IconaMetodo.astro';
import home from '../data/home.json';
// Testo della storia diviso in tre blocchi (titolo + paragrafo), scritto a mano: home.json viene rigenerato dallo script di migrazione.
import storiaSezioni from '../data/storia-sezioni.json';
import { formattaNumero } from '../data/stats';
import { formUrl, sedi } from '../data/site';
import { organizzazione, luogo, grafo } from '../lib/jsonld';

const heroImages = home.hero.immagini;
const fotoCarosello = home.marquee.map((src) => ({ src }));
const parole = ['club', 'fitness', 'wellness'];

// "Le nostre attivita' per adulti" -> titolo + parola in evidenza ("per adulti").
const dividiTitolo = (t: string) => {
	const m = t.match(/^(.*?)\s+(per\s+\w+)$/i);
	if (m) return { titolo: m[1], accento: m[2] };
	const parti = t.split(' ');
	return { titolo: parti.slice(0, -1).join(' '), accento: parti.at(-1)! };
};

const toCard = (c: { titolo: string; descrizione: string | null; href: string | null; immagine: string }) => ({
	href: c.href ?? '#',
	image: c.immagine,
	title: c.titolo,
	description: c.descrizione ?? undefined,
});

// Righe di card: fino a 4 in una riga; con 5 o piu', le prime 4 (o 3) e il resto sotto.
const righe = (items: ReturnType<typeof toCard>[]) => {
	if (items.length <= 4) return [items];
	const prima = items.length % 4 === 0 ? 4 : items.length === 5 ? 3 : 4;
	return [items.slice(0, prima), items.slice(prima)];
};

const gruppi = home.gruppi.map((g, i) => ({ ...g, ...dividiTitolo(g.titolo), righe: righe(g.card.map(toCard)), fondo: ['var(--bg-dark-deep)', 'var(--bg-dark)', 'var(--bg-dark-soft)'][i % 3], seguente: ['var(--bg-dark)', 'var(--bg-dark-soft)', 'var(--bg-dark)'][i % 3] }));
// Punti del Metodo: icona e colore del box, nell'ordine dei punti. I primi tre colori sono quelli
// delle parole del fumetto (Sogna grigio chiaro, Credici verde acqua, Allenati giallo).
const puntiMetodo = [
	{ icona: 'bersaglio', colore: '#d0d0d0' },
	{ icona: 'monitoraggio', colore: '#70c0a0' },
	{ icona: 'benessere', colore: 'var(--accent)' },
	{ icona: 'community', colore: '#ff9b7a' },
] as const;
const introHero = home.hero.intro.replace(/<\/?p>/g, '');
// La frase del metodo arriva spezzata in due paragrafi (e con un <br>): e' una frase sola.
const introMetodo = home.metodo.intro.join('').replace(/<br\s*\/?>/g, ' ').replace(/<\/p>\s*<p>/g, ' ');
---

<Layout headerTone="overlay" stack title={home.seo.title} description={home.seo.description} jsonLd={grafo(organizzazione(), ...sedi.map((s) => luogo(s)))}>
	<HeroCarousel images={heroImages} video={{ id: 'HCXI_Uh0JJw', inizio: 4, fine: 84 }}>
		<h1 class="hero__title" data-intro aria-label="Enjoy Club">
			<span aria-hidden="true">
				enjoy
				<span class="hero__rot">
					{parole.map((p, i) => <span class:list={{ 'is-on': i === 0 }}>{p}</span>)}
				</span>
			</span>
		</h1>
		<p class="hero__lead" data-intro style="--intro-delay: 0.2s" set:html={introHero} />
		<div data-intro style="--intro-delay: 0.4s">
			<a class="btn btn--pillola btn--lg hero__btn" href={formUrl('prova', 'Home')}>Prova ora</a>
		</div>
	</HeroCarousel>

	<section class="block--black marquee">
		<div data-anim="fade">
			<PhotoMarquee images={fotoCarosello} />
		</div>
	</section>

	<section class="block--accent sfuma storia" style="--da: var(--accent); --a: var(--bg-dark)">
		<div class="storia__inner">
			{
				home.storia.immagine && (
					<div class="storia__foto" data-anim="from-left">
						<Img src={home.storia.immagine} alt="Enjoy Club: due sedi, un'unica visione di qualità" class="img-cover" sizes="(max-width: 900px) 100vw, 46vw" />
					</div>
				)
			}
			<div class="storia__testo-col">
				<blockquote class="storia__quote" data-anim="from-right" set:html={home.storia.titolo.replace(/,\s*/, ',<br>')} />
				<div class="storia__testo">
					{
						storiaSezioni.map((s, i) => (
							<section class="storia__blocco" data-anim="fade" data-lato={i % 2 === 0 ? 'destra' : 'sinistra'}>
								<div class="storia__cartello">
									<h2 class="storia__titolo">{s.titolo}</h2>
									<p set:html={s.html} />
								</div>
							</section>
						))
					}
				</div>
				<div class="storia__cta" data-anim="fade">
					<a class="btn storia__btn" href="#sedi">
							<span>Scopri le nostre sedi</span>
							<svg class="storia__freccia" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M12 4v15" />
								<path d="m6 13 6 6 6-6" />
							</svg>
						</a>
				</div>
			</div>
		</div>
		<div class="contatori">
			{
				home.contatori.map((c, i) => (
					<div class="contatore" data-anim="up" data-anim-delay={String(i * 120)}>
						<span class="contatore__numero" data-counter data-target={c.target} data-suffix={c.suffisso}>
							{formattaNumero(c.target)}{c.suffisso}
						</span>
						<span class="contatore__titolo">{c.titolo}</span>
					</div>
				))
			}
		</div>
	</section>

	<script>
		import { formattaNumero } from '../data/stats';
		import { fissaAltezzaTitolo } from '../lib/fissaTitolo.client';

		// Il titolo riserva l'altezza della parola piu' alta (puo' andare a capo): testo e bottone restano fermi.
		fissaAltezzaTitolo(document.querySelector<HTMLElement>('.hero__title'), '.hero__rot > span');

		// Parole del titolo: ogni 2,5s passa la classe is-on alla successiva
		// (senza JS o con movimento ridotto resta la prima).
		const parolaHero = document.querySelectorAll<HTMLElement>('.hero__rot > span');
		if (parolaHero.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			let attiva = 0;
			setInterval(() => {
				parolaHero[attiva].classList.remove('is-on');
				attiva = (attiva + 1) % parolaHero.length;
				parolaHero[attiva].classList.add('is-on');
			}, 2500);
		}

		// L'HTML contiene gia' il valore finale (crawler, lettori di schermo, niente
		// JS): qui lo si azzera e lo si fa salire solo come effetto, e solo se la
		// persona non ha chiesto di ridurre i movimenti.
		const counters = document.querySelectorAll('[data-counter]');
		const riduciMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const anima = (el: Element) => {
			const target = Number(el.getAttribute('data-target'));
			const suffix = el.getAttribute('data-suffix') || '';
			const durata = 1500;
			const inizio = performance.now();
			function tick(ora: number) {
				const progresso = Math.min(1, (ora - inizio) / durata);
				const valore = Math.floor(progresso * target);
				el.textContent = formattaNumero(valore) + suffix;
				if (progresso < 1) requestAnimationFrame(tick);
				else el.textContent = formattaNumero(target) + suffix;
			}
			requestAnimationFrame(tick);
		};
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						anima(entry.target);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.4 }
		);
		if (!riduciMovimento) {
			counters.forEach((c) => {
				c.textContent = '0' + (c.getAttribute('data-suffix') || '');
				observer.observe(c);
			});
		}
	</script>

	<script>
		// Testo che "si accende" mentre si scorre: le parole di [data-rivela] passano da spente ad accese
		// seguendo lo scroll (anche all'indietro); le parole chiave (<strong>) si colorano con un
		// evidenziatore giallo. Senza JS o con "riduci movimento" il testo resta com'e', tutto acceso.
		const blocchi = document.querySelectorAll<HTMLElement>('[data-rivela]');
		if (blocchi.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			blocchi.forEach((blocco) => {
				const parole: HTMLElement[] = [];
				const chiavi: { el: HTMLElement; prima: number }[] = [];

				// ogni parola dentro un <span>; spazi e <br> restano dove sono
				const dividi = (nodo: Node) => {
					[...nodo.childNodes].forEach((figlio) => {
						if (figlio.nodeType === Node.TEXT_NODE) {
							const pezzi = (figlio.textContent ?? '').split(/(\s+)/);
							const frammento = document.createDocumentFragment();
							pezzi.forEach((pezzo) => {
								if (!pezzo) return;
								if (/^\s+$/.test(pezzo)) {
									frammento.append(pezzo);
									return;
								}
								const span = document.createElement('span');
								span.className = 'rv__w';
								span.textContent = pezzo;
								parole.push(span);
								frammento.append(span);
							});
							figlio.replaceWith(frammento);
						} else if (figlio.nodeType === Node.ELEMENT_NODE && (figlio as HTMLElement).tagName !== 'BR') {
							const el = figlio as HTMLElement;
							const prima = parole.length;
							dividi(el);
							if (el.tagName === 'STRONG') chiavi.push({ el, prima });
						}
					});
				};
				dividi(blocco);
				blocco.classList.add('rv--on');

				let attesa = false;
				const aggiorna = () => {
					attesa = false;
					const r = blocco.getBoundingClientRect();
					const vh = window.innerHeight;
					const inizio = vh * 0.9; // la prima parola si accende quando il blocco entra
					const fine = vh * 0.5; // tutte accese quando il fondo del blocco arriva a meta' schermo
					const p = Math.min(1, Math.max(0, (inizio - r.top) / (r.height + inizio - fine)));
					const accese = Math.round(p * parole.length);
					parole.forEach((w, i) => w.classList.toggle('is-lit', i < accese));
					chiavi.forEach(({ el, prima }) => el.classList.toggle('is-lit', prima < accese));
				};
				const richiedi = () => {
					if (!attesa) {
						attesa = true;
						requestAnimationFrame(aggiorna);
					}
				};
				addEventListener('scroll', richiedi, { passive: true });
				addEventListener('resize', richiedi);
				aggiorna();
			});
		}
	</script>

	<section class="metodo section on-dark sfuma" style="--da: var(--bg-dark); --a: var(--bg-dark-deep)">
		<div class="metodo__inner container-wide">
			<div class="metodo__intro" data-anim="from-left">
				<svg class="metodo__filtro" width="0" height="0" aria-hidden="true" focusable="false">
					<filter id="contorno-fumetto" x="-5%" y="-5%" width="110%" height="110%">
						<feMorphology in="SourceAlpha" operator="dilate" radius="1.5" result="ingrandita" />
						<feFlood style="flood-color: var(--accent)" result="giallo" />
						<feComposite in="giallo" in2="ingrandita" operator="in" result="contorno" />
						<feMerge>
							<feMergeNode in="contorno" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>
				</svg>
				<div class="metodo__testa">
					<h2 class="display-title metodo__titolo">Il nostro <span class="accent-text">Metodo</span></h2>
					{
						home.metodo.immagine && (
							<span class="metodo__fumetto">
								<Img src={home.metodo.immagine} alt="" class="metodo__img" sizes="(max-width: 900px) 40vw, 18vw" />
							</span>
						)
					}
				</div>
				<div class="metodo__frase" set:html={introMetodo} />
			</div>
			<ol class="metodo__punti">
				{
					home.metodo.punti.map((p, i) => (
						<li data-anim="up" data-anim-delay={String(i * 120)} style={`--c:${puntiMetodo[i].colore}; --d:${(0.25 + i * 0.12).toFixed(2)}s`}>
								<IconaMetodo nome={puntiMetodo[i].icona} />
								<div class="metodo__txt">
									<h3>{p.titolo}</h3>
									<div set:html={p.html} />
								</div>
							</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="attivita">
		{
			gruppi.map((g, i) => (
				<div class="attivita__block sfuma" style={`--block-bg:${g.fondo}; --da:${g.fondo}; --a:${g.seguente}`}>
					<SectionTitle accent={g.accento} gap={0}>
						{g.titolo}
					</SectionTitle>
					<div class="attivita__desc container-wide on-dark" data-anim="fade" data-rivela set:html={g.html} />
					{(() => {
						let n = 0;
						return g.righe.map((riga) => {
							const start = n;
							n += riga.length;
							return <ActivityGrid items={riga} columns={riga.length} startIndex={start} gapTop={start === 0 ? 28 : 20} />;
						});
					})()}
				</div>
			))
		}
	</section>

	<section class="planning">
		<div class="container-wide planning__wrap">
			<div class="planning__inner" data-anim="up">
				<div class="planning__media">
					<Img
						class="planning__img planning__img--main"
						src={home.marquee[0]}
						alt="Corsi di Enjoy Club"
						sizes="(max-width: 900px) 90vw, 36vw"
						data-anim="scale"
					/>
					<Img
						class="planning__img planning__img--accent"
						src={home.marquee[2] ?? home.marquee[1]}
						alt="Piscina di Enjoy Club"
						sizes="(max-width: 900px) 55vw, 22vw"
						data-anim="scale"
						data-anim-delay="150"
					/>
				</div>
				<div class="planning__text">
					<div class="planning__blocco" data-anim="fade" data-anim-delay="200">
						<div class="planning__cartello">
							<div class="planning__testa">
								<IconaMetodo nome="calendario" />
								<h2>I nostri orari</h2>
							</div>
							<p class="planning__sotto"><strong>Allenati con i migliori!</strong></p>
							<div class="planning__corpo" set:html={home.orari.testo} />
						</div>
					</div>
					<div class="planning__cta" data-anim="up" data-anim-delay="500">
						<a class="btn storia__btn" href="/orari">
							<span>Planning settimanale</span>
							<svg class="planning__freccia" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 12h15" />
								<path d="m13 6 6 6-6 6" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="block--black section testimonianze sfuma" style="--da: var(--bg-dark); --a: var(--accent)">
		<SectionTitle align="right" line="text" gap={40}>Parola di chi si allena qui</SectionTitle>
		<div class="container-wide">
			<div class="testimonianze__grid">
				{
					home.testimonianze.map((t, i) => (
						<figure class="testimonianza" data-anim="scale" data-anim-delay={String(i * 120)}>
							<div class="testimonianza__stars" aria-hidden="true">★★★★★</div>
							<blockquote class="testimonianza__testo">{t.testo}</blockquote>
							<figcaption class="testimonianza__autore">
								<span class="testimonianza__avatar" aria-hidden="true">{t.nome.charAt(0)}</span>
								<span class="testimonianza__nome">{t.nome}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<div class="testimonianze__punti" aria-label="Scegli la recensione">
				{
					home.testimonianze.map((_, i) => (
						<button class="testimonianze__punto" type="button" aria-label={`Recensione ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
					))
				}
			</div>
		</div>
	</section>
</Layout>

<script>
	// Puntini delle recensioni: mostrano quale card e' in vista e, toccati, ci portano.
	const fila = document.querySelector<HTMLElement>('.testimonianze__grid');
	const punti = Array.from(document.querySelectorAll<HTMLButtonElement>('.testimonianze__punto'));
	if (fila && punti.length > 1) {
		const passo = () => (fila.children[1] as HTMLElement).offsetLeft - (fila.children[0] as HTMLElement).offsetLeft;
		const aggiorna = () => {
			const i = Math.max(0, Math.min(punti.length - 1, Math.round(fila.scrollLeft / passo())));
			punti.forEach((p, k) => (k === i ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
		};
		fila.addEventListener('scroll', aggiorna, { passive: true });
		punti.forEach((p, k) => p.addEventListener('click', () => fila.scrollTo({ left: passo() * k, behavior: 'smooth' })));
	}
</script>

<style>
	.hero__title {
		color: var(--bg-alt);
		font-size: clamp(2.25rem, 8.4vw, 5.5rem);
		margin-bottom: 16px;
	}

	/* Parole che si alternano dopo "enjoy", una alla volta (le cambia lo script).
	   Solo la parola attiva occupa spazio nella riga: le altre sono assolute e
	   invisibili, cosi' "enjoy + parola" e' sempre centrato come testo normale. */
	.hero__rot {
		position: relative;
		display: inline-block;
		margin-left: 0.25em;
		color: var(--accent);
		white-space: nowrap;
	}

	.hero__rot > span {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transform: translateY(0.35em);
		transition:
			opacity 0.3s,
			transform 0.3s;
	}

	.hero__rot > span.is-on {
		position: static;
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__rot > span {
			transition: none;
		}
	}

	.accent-text {
		color: var(--accent);
		font-style: italic;
	}

	.hero__lead {
		max-width: 680px;
		margin: 0 auto 24px;
		font-size: var(--text-md);
		color: var(--text-on-dark);
	}

	.hero__lead :global(strong) {
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.hero__lead {
			font-size: var(--text-base);
		}
	}

	/* In fondo alla hero la foto sfuma nel nero della striscia di foto che segue. Sta sotto il
	   testo della hero (che ha z-index 1). */
	:global(.hc)::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 72px;
		background: linear-gradient(to bottom, transparent, var(--bg-dark));
		pointer-events: none;
	}

	/* Sotto la striscia di foto il nero sfuma nel giallo della sezione che segue: 40px di sfumo
	   + 16px di giallo = la solita fascia di 56px tra sezioni. */
	section.marquee::after {
		content: '';
		display: block;
		height: 40px;
		background: linear-gradient(to bottom, var(--bg-dark), var(--accent));
	}

	.marquee + section {
		border-top-width: 16px;
	}

	/* Lo sfumo tra una sezione e la successiva (.sfuma, --da e --a) e' in global.css: lo usano anche le pagine interne.

	   Spazi tra sezioni: tra i contenuti di due sezioni consecutive ci sono 112px. Dove il colore cambia
	   (sezioni con sfumo) sono ripartiti in modo simmetrico: 36px pieni + 40px di sfumo in fondo alla
	   sezione che finisce (padding-bottom 76px) e 36px pieni di fascia in cima alla successiva. */
	.attivita ~ .planning {
		border-top-width: 36px;
	}

	/* Numeri e Metodo hanno piu' aria sopra e sotto: 56px pieni + 40px di sfumo + 56px pieni (152px tra i contenuti). */
	.storia ~ .metodo,
	.metodo ~ .attivita {
		border-top-width: 56px;
	}

	.section {
		padding-block: 56px;
	}

	/* Le sezioni sono gia' precedute dalla fascia di 56px tra sezioni (vedi
	   ".main--stack" in global.css): niente doppio padding in alto. */
	section.section {
		padding-top: 0;
	}

	.attivita__block {
		background: var(--block-bg);
		padding-block: 56px 76px;
	}

	.attivita__block + .attivita__block {
		padding-top: 36px;
	}

	/* Stesso discorso: il primo blocco della sezione "attivita" e' gia'
	   preceduto dalla fascia tra sezioni. */
	.attivita__block:first-child {
		padding-top: 0;
	}

	.attivita__desc {
		max-width: calc(60rem + 2 * var(--gutter));
		margin-top: 20px;
		color: var(--text-on-dark);
		font-size: var(--text-md);
		line-height: 1.7;
	}

	.attivita__desc :global(p) {
		margin: 0;
	}

	/* Primo blocco: testo piu' grande che si accende allo scroll (vedi lo script sopra). */
	.attivita__desc[data-rivela] {
		max-width: calc(70rem + 2 * var(--gutter));
		font-size: clamp(1.2rem, 4.8vw, 1.65rem);
		font-weight: 500;
		line-height: 1.45;
	}

	.attivita__desc[data-rivela] :global(.rv__w) {
		transition: opacity 0.35s ease;
	}

	.attivita__desc[data-rivela].rv--on :global(.rv__w) {
		opacity: 0.25;
	}

	.attivita__desc[data-rivela].rv--on :global(.rv__w.is-lit) {
		opacity: 1;
	}

	/* Parole chiave: evidenziatore giallo che si disegna da sinistra; il testo passa al nero. */
	.attivita__desc[data-rivela].rv--on :global(strong) {
		padding: 0.02em 0.22em;
		margin: 0 -0.1em;
		border-radius: 0.2em;
		background: linear-gradient(var(--accent), var(--accent)) no-repeat left center / 0% 100%;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		transition:
			background-size 0.6s var(--ease-out-crit),
			color 0.3s ease 0.15s;
	}

	.attivita__desc[data-rivela].rv--on :global(strong.is-lit) {
		background-size: 100% 100%;
		color: var(--bg-dark-deep);
	}

	/* --- Storia: foto a sinistra, testo a destra, numeri sotto (su fondo giallo) --- */
	.storia__inner {
		display: grid;
		grid-template-columns: 46% 1fr;
		align-items: stretch;
		min-height: 420px;
	}

	.storia__foto {
		position: relative;
		overflow: hidden;
		min-height: 0;
		align-self: center;
		/* Proporzioni della foto (940x788, leggermente piu' bassa per tagliare il bordo nero sotto i busti):
		   il riquadro non si allunga con il testo, quindi la foto non viene ingrandita e tagliata. */
		aspect-ratio: 940 / 710;
		border-radius: 0 20px 20px 0;
	}

	.storia__foto :global(img) {
		object-position: 50% 15%;
	}

	.storia__testo-col {
		padding: 40px 5% 32px;
	}

	.storia__quote {
		margin: 0 0 24px;
		font-family: var(--font-heading);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.15;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--on-accent);
	}

	/* Tre "cartelli" neri (titolo giallo + paragrafo bianco) che entrano di lato: il primo da destra,
	   il secondo da sinistra, il terzo da destra. Il contenitore .storia__blocco resta fermo (e' lui
	   che l'osservatore dello scroll vede); si muove solo il cartello dentro. Il ritaglio orizzontale
	   sulla sezione evita che il cartello, fuori schermo, allarghi la pagina. */
	.storia__inner {
		overflow-x: clip;
	}

	.storia__blocco {
		margin: 0 0 20px;
	}

	.storia__cartello {
		position: relative;
		padding: 24px 22px 26px;
		border-radius: 18px;
		background: var(--bg-dark-deep);
		box-shadow: 0 14px 28px -14px rgba(0, 0, 0, 0.55);
	}

	/* Due "viti" gialle negli angoli, come un cartello vero. */
	.storia__cartello::before,
	.storia__cartello::after {
		content: '';
		position: absolute;
		top: 10px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.storia__cartello::before {
		left: 10px;
	}

	.storia__cartello::after {
		right: 10px;
	}

	.storia__titolo {
		margin: 0 0 12px;
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 800;
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--accent);
	}

	/* Sottolineatura gialla che si disegna dopo l'arrivo del cartello. */
	.storia__titolo::after {
		content: '';
		display: block;
		width: 48px;
		height: 3px;
		margin-top: 8px;
		background: var(--accent);
		transform-origin: left;
	}

	.storia__cartello p {
		margin: 0;
		color: var(--text-on-dark);
	}

	.storia__cartello :global(strong) {
		color: var(--accent);
	}

	:global(.js) .storia__cartello {
		transition: transform 1.1s var(--ease-out-crit);
	}

	:global(.js) .storia__blocco[data-lato='destra'] .storia__cartello {
		transform: translateX(120%) rotate(5deg);
	}

	:global(.js) .storia__blocco[data-lato='sinistra'] .storia__cartello {
		transform: translateX(-120%) rotate(-5deg);
	}

	:global(.js) .storia__blocco:global(.is-visible) .storia__cartello {
		transform: none;
	}

	:global(.js) .storia__titolo::after {
		transform: scaleX(0);
		transition: transform 0.6s ease 0.7s;
	}

	:global(.js) .storia__blocco:global(.is-visible) .storia__titolo::after {
		transform: scaleX(1);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .storia__cartello,
		:global(.js) .storia__titolo::after {
			transform: none !important;
			transition: none;
		}
	}

	.storia__cta {
		margin-top: 8px;
		text-align: center;
	}

	/* Bottone: pillola nera con testo giallo e freccia, un lampo di luce che lo attraversa a intervalli,
	   un'onda che si espande dal bordo e la freccia che "invita" a scendere. */
	.storia__btn {
		--btn-border: var(--bg-dark-deep);
		--btn-hover-text: var(--accent);
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 18px 32px;
		border-radius: var(--radius-pill);
		background: var(--bg-dark-deep);
		color: var(--accent);
		font-size: 17px;
		letter-spacing: 0.02em;
		box-shadow:
			0 12px 24px -10px rgba(0, 0, 0, 0.6),
			0 0 0 0 rgba(13, 13, 13, 0.35);
		animation: storia-onda 3s ease-out infinite;
	}

	.storia__btn::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: -60%;
		width: 40%;
		background: linear-gradient(100deg, transparent, rgba(255, 230, 0, 0.4), transparent);
		transform: skewX(-20deg);
		animation: storia-lampo 3.6s ease-in-out 1s infinite;
	}

	.storia__freccia {
		flex-shrink: 0;
		animation: storia-freccia 1.6s ease-in-out infinite;
	}

	@keyframes storia-onda {
		0% {
			box-shadow:
				0 12px 24px -10px rgba(0, 0, 0, 0.6),
				0 0 0 0 rgba(13, 13, 13, 0.35);
		}
		70%,
		100% {
			box-shadow:
				0 12px 24px -10px rgba(0, 0, 0, 0.6),
				0 0 0 16px rgba(13, 13, 13, 0);
		}
	}

	@keyframes storia-lampo {
		0%,
		55% {
			left: -60%;
		}
		100% {
			left: 130%;
		}
	}

	@keyframes storia-freccia {
		0%,
		100% {
			transform: translateY(-2px);
		}
		50% {
			transform: translateY(4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.storia__btn,
		.storia__btn::after,
		.storia__freccia {
			animation: none;
		}
	}

	/* Numeri sul giallo: cifre grandi e pesanti in nero, separate da linee sottili; sotto ogni cifra
	   una barra nera che si disegna all'entrata. */
	.contatori {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		padding: 64px var(--gutter) 96px;
	}

	.contatore {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 8px 32px;
		border-left: 1px solid var(--on-accent);
	}

	.contatore:first-child {
		border-left: none;
		padding-left: 0;
	}

	.contatore__numero {
		display: block;
		font-family: var(--font-heading);
		font-weight: 900;
		font-size: clamp(3.25rem, 6.6vw, 6rem);
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		color: var(--on-accent);
	}

	.contatore__numero::after {
		content: '';
		display: block;
		width: 56px;
		height: 5px;
		margin: 14px auto 16px;
		border-radius: 3px;
		background: var(--on-accent);
		transform-origin: center;
	}

	:global(.js) .contatore__numero::after {
		transform: scaleX(0);
		transition: transform 0.7s var(--ease-out-crit) 0.5s;
	}

	:global(.js) .contatore:global(.is-visible) .contatore__numero::after {
		transform: scaleX(1);
	}

	.contatore__titolo {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 800;
		line-height: 1.15;
		text-transform: uppercase;
		color: var(--on-accent);
	}

	/* --- Metodo: titolo e frase a sinistra, quattro punti numerati a destra --- */
	/* Fondo come quello del fumetto (la sua foto e' sul #0d0d0d): su nero puro si vedeva un rettangolo. */
	.metodo {
		background: var(--bg-dark);
		color: var(--text-on-dark);
		padding-top: 0 !important;
		padding-bottom: 96px;
	}

	.metodo__inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
		gap: 56px;
		align-items: start;
	}

	/* Titolo e fumetto sulla stessa riga: titolo a sinistra, fumetto a destra. */
	.metodo__filtro {
		position: absolute;
	}

	.metodo__testa {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 20px;
	}

	/* Il bordo giallo "respira": un leggero alone giallo che pulsa e segue la sagoma (coda compresa). */
	.metodo__fumetto {
		flex-shrink: 0;
		line-height: 0;
		animation: metodo-bagliore 3.2s ease-in-out infinite;
	}

	@keyframes metodo-bagliore {
		0%,
		100% {
			filter: drop-shadow(0 0 0 rgba(255, 230, 0, 0));
		}
		50% {
			filter: drop-shadow(0 0 7px rgba(255, 230, 0, 0.6));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.metodo__fumetto {
			animation: none;
		}
	}

	.metodo__testa :global(.metodo__img) {
		flex-shrink: 0;
		width: clamp(110px, 36vw, 170px);
		height: auto;
		/* Il fumetto e' nero come lo sfondo: contorno giallo che segue la sagoma dell'immagine
		   (fumetto e coda). Il filtro e' definito nell'SVG qui sopra nella pagina. */
		filter: url(#contorno-fumetto);
	}

	.metodo__titolo {
		margin-bottom: 0;
		font-size: clamp(2.2rem, 3.6vw, 3.25rem);
		line-height: 1;
		color: var(--text-on-dark);
	}

	.metodo__frase :global(p) {
		margin: 0 0 0.6em;
		font-size: var(--text-md);
		line-height: 1.6;
	}

	.metodo__punti {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px 40px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Ogni punto: box quadrato colorato con l'icona a sinistra, titolo e testo a destra. */
	.metodo__punti li {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 16px;
		align-items: center;
	}

	.metodo__punti li :global(.ico) {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: var(--c);
		color: var(--bg-dark);
		box-shadow: 0 8px 20px -8px var(--c);
	}

	.metodo__punti li :global(.ico svg) {
		width: 28px;
		height: 28px;
		overflow: visible;
	}

	.metodo__txt h3 {
		margin: 2px 0 4px;
		font-size: var(--text-lg);
		color: var(--accent);
	}

	.metodo__txt :global(p) {
		margin: 0;
		color: var(--text-on-dark);
		line-height: 1.5;
	}

	/* --- Animazioni dei punti --- */
	/* Entrata (con JS): il box salta fuori con un piccolo rimbalzo e ruota, poi l'icona si "disegna". */
	:global(.js) .metodo__punti li :global(.ico) {
		opacity: 0;
		transform: scale(0.3) rotate(-24deg);
		transition:
			opacity 0.35s ease var(--d, 0s),
			transform 0.8s var(--ease-spring) var(--d, 0s);
	}

	:global(.js) .metodo__punti li :global(.is-visible) :global(.ico),
	:global(.js) .metodo__punti li:global(.is-visible) :global(.ico) {
		opacity: 1;
		transform: none;
	}

	:global(.js) .metodo__punti li :global(.ico svg [pathLength]) {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 0.9s ease calc(var(--d, 0s) + 0.35s);
	}

	:global(.js) .metodo__punti li:global(.is-visible) :global(.ico svg [pathLength]) {
		stroke-dashoffset: 0;
	}

	/* Movimento continuo, leggero e diverso per ogni icona (parte dopo l'entrata). */
	.metodo__punti :global(.ico__punto) {
		transform-box: fill-box;
		transform-origin: center;
		animation: ico-pulsa 2.4s ease-in-out 1.6s infinite;
	}

	.metodo__punti :global(.ico--monitoraggio svg) {
		animation: ico-batti 2s ease-in-out 1.6s infinite;
	}

	.metodo__punti :global(.ico__giro) {
		transform-origin: 12px 12px;
		animation: ico-gira 9s linear 1.6s infinite;
	}

	.metodo__punti :global(.ico__testa) {
		animation: ico-saltella 2.2s ease-in-out 1.6s infinite;
	}

	.metodo__punti :global(.ico__testa--b) {
		animation-delay: 2.3s;
	}

	@keyframes ico-pulsa {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(2);
		}
	}

	@keyframes ico-batti {
		0%,
		55%,
		100% {
			transform: scale(1);
		}
		15% {
			transform: scale(1.16);
		}
		30% {
			transform: scale(0.96);
		}
	}

	@keyframes ico-gira {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes ico-saltella {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-1.5px);
		}
	}

	@media (hover: hover) {
		.metodo__punti li:hover :global(.ico) {
			transform: rotate(-7deg) scale(1.1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .metodo__punti li :global(.ico) {
			opacity: 1;
			transform: none;
			transition: none;
		}

		:global(.js) .metodo__punti li :global(.ico svg [pathLength]) {
			stroke-dashoffset: 0;
			transition: none;
		}

		.metodo__punti :global(.ico__punto),
		.metodo__punti :global(.ico--monitoraggio svg),
		.metodo__punti :global(.ico__giro),
		.metodo__punti :global(.ico__testa) {
			animation: none;
		}
	}

	/* Fondo scuro continuo con le testimonianze sotto; il contenuto sta in una card chiara. */
	section.planning {
		background: var(--bg-dark);
	}

	.planning__wrap {
		padding-bottom: 56px;
	}

	.planning__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 56px;
		align-items: center;
		padding: 40px;
		border-radius: var(--radius-lg);
		/* Riquadro giallo: come nella CTA finale, sul giallo il testo e' nero pieno. */
		--text: var(--bg-dark-deep);
		background: var(--accent);
		color: var(--text);
	}

	/* Foto principale verticale + seconda foto piu' piccola sovrapposta in
	   basso a destra, con cornice. */
	.planning__media {
		position: relative;
		padding: 0 1.5rem 2.5rem 0;
	}

	.planning__media :global(.planning__img) {
		display: block;
		width: 100%;
		object-fit: cover;
		border-radius: 16px;
	}

	.planning__media :global(.planning__img--main) {
		height: clamp(300px, calc(var(--screen-h) - 235px), 580px);
	}

	.planning__media :global(.planning__img--accent) {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 58%;
		aspect-ratio: 4 / 3;
		border: 6px solid var(--bg-alt);
		box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.35);
	}

	/* Testo come i "cartelli" della storia: riquadro nero con titolo giallo e testo bianco che entra
	   da destra; sotto, il bottone a pillola. */
	.planning__inner {
		overflow-x: clip;
	}

	.planning__text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		min-width: 0;
	}

	/* Il bottone (stile della storia) deve stare nella colonna: niente a capo, ma padding e corpo piu' piccoli. */
	.planning__cta {
		max-width: 100%;
	}

	.planning__cta :global(.storia__btn) {
		max-width: 100%;
		padding: 16px 24px;
		font-size: 15px;
	}

	.planning__blocco {
		width: 100%;
	}

	.planning__cartello {
		position: relative;
		padding: 28px 24px 28px;
		border-radius: 18px;
		background: var(--bg-dark-deep);
		box-shadow: 0 14px 28px -14px rgba(0, 0, 0, 0.55);
	}

	.planning__cartello::before,
	.planning__cartello::after {
		content: '';
		position: absolute;
		top: 10px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}

	.planning__cartello::before {
		left: 10px;
	}

	.planning__cartello::after {
		right: 10px;
	}

	.planning__testa {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 16px;
	}

	.planning__testa :global(.ico) {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.planning__testa :global(.ico svg) {
		width: 28px;
		height: 28px;
	}

	.planning__text h2 {
		margin: 0;
		color: var(--accent);
		font-size: clamp(1.5rem, 5.6vw, 2.1rem);
		line-height: 1.1;
		text-transform: uppercase;
	}

	/* Sottolineatura gialla sotto al titolo, che si disegna dopo l'arrivo del cartello. */
	.planning__text h2::after {
		content: '';
		display: block;
		width: 40px;
		height: 3px;
		margin-top: 8px;
		background: var(--accent);
		transform-origin: left;
	}

	.planning__sotto {
		margin: 0 0 8px;
		color: var(--text-on-dark);
		font-size: var(--text-md);
	}

	.planning__corpo :global(p) {
		margin: 0;
		color: var(--text-on-dark);
	}

	:global(.js) .planning__cartello {
		transform: translateX(120%) rotate(5deg);
		transition: transform 1.1s var(--ease-out-crit) 0.1s;
	}

	:global(.js) .planning__blocco:global(.is-visible) .planning__cartello {
		transform: none;
	}

	:global(.js) .planning__text h2::after {
		transform: scaleX(0);
		transition: transform 0.6s ease 0.9s;
	}

	:global(.js) .planning__blocco:global(.is-visible) h2::after {
		transform: scaleX(1);
	}

	/* Il bottone e' lo stesso della storia (.storia__btn); qui la freccia punta a destra. */
	.planning__freccia {
		flex-shrink: 0;
		animation: planning-freccia 1.6s ease-in-out infinite;
	}

	@keyframes planning-freccia {
		0%,
		100% {
			transform: translateX(-2px);
		}
		50% {
			transform: translateX(5px);
		}
	}

	/* Icona del calendario: la spunta batte piano. */
	.planning__testa :global(.ico__spunta) {
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
		transform-box: fill-box;
		transform-origin: center;
		animation: planning-spunta 3s ease-in-out 1.2s infinite;
	}

	@keyframes planning-spunta {
		0%,
		70%,
		100% {
			transform: scale(1);
		}
		82% {
			transform: scale(1.35);
		}
	}

	/* La seconda foto ha la cornice nera, e' leggermente inclinata e "galleggia". */
	.planning__media :global(.planning__img--accent) {
		border-color: var(--bg-dark-deep);
		rotate: 2.5deg;
		animation: planning-fluttua 5s ease-in-out infinite;
	}

	@keyframes planning-fluttua {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -7px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .planning__cartello,
		:global(.js) .planning__text h2::after {
			transform: none !important;
			transition: none;
		}

		.planning__freccia,
		.planning__testa :global(.ico__spunta),
		.planning__media :global(.planning__img--accent) {
			animation: none;
		}
