---
import Layout from '../layouts/Layout.astro';
import ModuloRichiesta from '../components/ModuloRichiesta.astro';
import ElencoProva from '../components/ElencoProva.astro';
---

<Layout title="Richiedi la prova - Enjoy Club" description="Richiedi la prova gratuita per Gym Floor, Corsi Fitness, Acqua Fitness, Nuoto Libero e Health Fitness nelle sedi Enjoy Club di Camuzzago e Meda." noindex>
	<section class="pagina-modulo on-dark">
		<p class="pill">Richiesta prova</p>
		<h1 class="display-title pagina-modulo__titolo">Richiedi la prova</h1>
		<div class="pagina-modulo__testo"><ElencoProva /></div>
		<ModuloRichiesta tipo="prova" />
	</section>
</Layout>

<style>
	.pagina-modulo {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
		min-height: calc(100svh - var(--header-h));
		padding: clamp(40px, 6vw, 80px) var(--gutter);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.pagina-modulo__titolo {
		margin: 0;
		color: var(--text-on-dark);
	}

	.pagina-modulo__testo {
		margin: 0;
		max-width: 38rem;
		line-height: 1.6;
	}
</style>
