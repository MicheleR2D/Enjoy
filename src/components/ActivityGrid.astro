---
// Griglia di card "attività": foto a tutta card con numero, titolo grande e, in hover,
// descrizione e pulsante. Disposizione a griglia fissa (da 1 a 4 colonne), non un carosello.
import Img from './Img.astro';

interface Item {
	href: string;
	image: string;
	title: string;
	/** Se manca, in hover compare solo "Scopri di piu'". */
	description?: string;
}
interface Props {
	items: Item[];
	columns?: number;
	/** Spazio sopra la griglia: deve coincidere con lo spazio che il titolo
	 * della sezione ha sopra di se' (padding-top della sezione precedente),
	 * per mantenere la stessa geometria sopra e sotto al titolo. */
	gapTop?: number;
	/** Numero da cui continuare la numerazione (per una riga finale resa
	 * come griglia separata, es. attivita' adulti: 4 card + una seconda riga a 3). */
	startIndex?: number;
}
const { items, columns = 3, gapTop = 56, startIndex = 0 } = Astro.props;
---

<div class="grid" style={`--grid-columns:${columns}; --grid-gap-top:${gapTop}px`}>
	{
		items.map((item, i) => (
			<a href={item.href} class="card" data-neon data-anim="scale" data-anim-delay={String(i * 150)}>
				<div class="card__clip">
					<Img
							src={item.image}
							class="card__img"
							sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 34vw"
						/>
					<div class="card__scrim" />
					<div class="card__body">
						<span class="card__num">{String(startIndex + i + 1).padStart(2, '0')}</span>
						<strong class="card__name">{item.title}</strong>
						<div class="card__hover">
							{item.description && <p class="card__desc">{item.description}</p>}
							<span class="btn card__more">Scopri di più →</span>
						</div>
					</div>
				</div>
			</a>
		))
	}
</div>

<script>
	// Il neon si accende solo quando la card e' interamente visibile (non al
	// primo affacciarsi dal bordo, come il resto del reveal-on-scroll), sempre
	// una card alla volta grazie allo stesso ritardo di data-anim-delay.
	const neonObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const el = entry.target as HTMLElement;
				const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
				window.setTimeout(() => el.classList.add('neon-in'), delay);
				neonObserver.unobserve(el);
			});
		},
		{ threshold: 1 }
	);

	// Con "riduci movimento" niente neon all'entrata.
	if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLElement>('[data-neon]').forEach((el) => neonObserver.observe(el));
	}
</script>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), 1fr);
		gap: 20px;
		padding-inline: var(--gutter);
		margin-top: var(--grid-gap-top);
	}

	.card {
		position: relative;
		/* Altezza fissa (non aspect-ratio): cosi' resta identica in ogni
		   sezione anche quando il numero di colonne cambia (es. Servizi
		   extra a 2 colonne invece di 3) e le card sono piu' larghe. */
		height: clamp(220px, 24vw, 340px);
		display: block;
		border-radius: var(--radius);
		background: var(--bg-dark);
		color: var(--text-on-dark);
		box-shadow: 0 0 22px rgba(0, 0, 0, 0.22);
		/* Nessun transform di base: lascia partire quello dell'entrata
		   (data-anim="scale"); l'opacita' va nella stessa transition,
		   altrimenti questa regola la sovrascrive e la card compare di colpo. */
		transition:
			transform var(--dur-base) var(--ease-spring),
			box-shadow var(--dur-base) var(--ease-out-crit),
			opacity 0.6s var(--ease-out-crit);
		/* Evita che Chrome "squadri" per un istante gli angoli arrotondati
		   quando la card entra nel proprio layer composito durante l'hover. */
		will-change: transform;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-10px) scale(1.015);
		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.3), 0 0 0 2px var(--accent), 0 0 22px 4px rgba(255, 230, 0, 0.5);
	}

	.card:active {
		transform: scale(0.985);
		transition-duration: var(--dur-press);
	}

	/* Il neon si accende una volta sola quando la card entra in vista
	   scorrendo (in sequenza, una card alla volta grazie al ritardo di
	   data-anim-delay), poi si spegne; l'hover lo riaccende. */
	@keyframes card-neon-sweep {
		0%,
		100% {
			box-shadow: 0 0 22px rgba(0, 0, 0, 0.22);
		}
		45% {
			box-shadow: 0 0 22px rgba(0, 0, 0, 0.22), 0 0 0 2px var(--accent), 0 0 24px 6px rgba(255, 230, 0, 0.55);
		}
	}

	.card.neon-in {
		animation: card-neon-sweep 1s ease-out;
	}

	.card__clip {
		position: absolute;
		inset: 0;
		border-radius: var(--radius);
		overflow: hidden;
		transform: translateZ(0);
	}

	.card :global(.card__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.card:hover :global(.card__img),
	.card:focus-visible :global(.card__img) {
		transform: scale(1.06);
	}

	.card__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(17, 17, 17, 0) 40%, rgba(17, 17, 17, 0.88) 82%, rgba(17, 17, 17, 1) 96%);
		transition: background 0.35s ease;
	}

	.card:hover .card__scrim,
	.card:focus-visible .card__scrim {
		background: linear-gradient(180deg, rgba(17, 17, 17, 0.15) 0%, rgba(17, 17, 17, 0.94) 78%, rgba(17, 17, 17, 1) 96%);
	}

	.card__body {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 1.5rem;
	}

	.card__num {
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin-bottom: 6px;
	}

	.card__name {
		display: block;
		font-family: var(--font-heading);
		text-transform: uppercase;
		letter-spacing: -0.015em;
		line-height: 0.95;
		font-weight: 800;
		font-size: clamp(1.5rem, 2.4vw, 2.2rem);
		color: var(--accent);
	}

	.card__hover {
		max-height: 0;
		opacity: 0;
		transform: translateY(10px);
		overflow: hidden;
		transition: opacity 0.35s ease, transform 0.35s ease, max-height 0.35s ease;
	}

	.card:hover .card__hover,
	.card:focus-visible .card__hover {
		max-height: 9rem;
		opacity: 1;
		transform: translateY(0);
		margin-top: 8px;
	}

	.card__desc {
		font-size: var(--text-sm);
		color: rgba(255, 255, 255, 0.8);
		line-height: 1.5;
		margin: 0 0 12px;
		font-family: var(--font-sans);
		text-transform: none;
	}

	.card__more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.08em;
		padding: 0.55rem 1rem;
		border-radius: 100px;
	}

	/* Il pallino sta vicino al bordo basso/sinistro di due contenitori con
	   overflow:hidden: lo zoom deve crescere verso sinistra e verso l'alto
	   (non verso destra/basso, dove verrebbe tagliato). */
	.card__more {
		transform-origin: left bottom;
	}

	/* Su touch non esiste l'hover: descrizione e "Scopri di più" restano sempre
	   visibili (prima comparivano solo al passaggio del mouse, quindi mai). */
	@media (hover: none) {
		.card {
			height: clamp(280px, 70vw, 340px);
		}

		.card__scrim {
			background: linear-gradient(180deg, rgba(17, 17, 17, 0.15) 0%, rgba(17, 17, 17, 0.94) 78%, rgba(17, 17, 17, 1) 96%);
		}

		.card__hover {
			max-height: 9rem;
			opacity: 1;
			transform: none;
			margin-top: 8px;
		}

		.card__desc {
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
