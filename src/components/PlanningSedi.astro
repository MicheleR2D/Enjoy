---
/*
 * Planning settimanale delle due sedi. Struttura come la pagina orari di Body Energie: tab per
 * scegliere la sede, tab dei giorni (si parte da oggi), frecce giorno precedente/successivo e
 * filtro per tipo di lezione (acqua, sala, outdoor). I dati sono quelli dei PDF dei planning,
 * in src/data/planning-sedi.json: giorno -> lezioni con orario, corso, istruttore e sala.
 *
 * Senza JavaScript le sedi e i giorni si leggono uno dopo l'altro; con JavaScript compaiono tab,
 * frecce e filtro. Il nome del corso e' un link alla sua scheda quando la scheda esiste.
 */
import planning from '../data/planning-sedi.json';
import { imgSources } from '../lib/img';

const GIORNI = [
	{ id: 'LUN', nome: 'Lunedì' },
	{ id: 'MAR', nome: 'Martedì' },
	{ id: 'MER', nome: 'Mercoledì' },
	{ id: 'GIO', nome: 'Giovedì' },
	{ id: 'VEN', nome: 'Venerdì' },
	{ id: 'SAB', nome: 'Sabato' },
	{ id: 'DOM', nome: 'Domenica' },
];

const TIPI: Record<string, string> = { acqua: 'Acqua', sala: 'Sala', outdoor: 'Outdoor' };

// Corso (come scritto nel planning) -> scheda. Se la scheda non esiste, o non ha quel corso, la lezione
// resta senza link: meglio nessun pop-up che uno con il testo di un altro corso.
const pagine = import.meta.glob('../data/pagine/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const perSlug: Record<string, any> = {};
for (const p of Object.values(pagine)) perSlug[p.slug] = p;
const REGOLE: [RegExp, string][] = [
	[/^acqua (tone|circuit)|^brucia grassi$|^idrobike/i, 'acqua-gym'],
	[/^ginn\. acq\./i, 'ginnastica-terapeutica-acquatica'],
	[/^postural pil/i, 'postural-pil'],
	[/^back school/i, 'back-school'],
	[/^body balance/i, 'body-balance'],
	[/^body pump/i, 'body-pump'],
	[/^group cycling/i, 'groupcycling'],
	[/^suspension/i, 'suspension'],
	[/^tabata$/i, 'tabata'],
	[/^total body/i, 'total-body'],
	[/^yoga/i, 'yoga'],
	[/^spartan/i, 'spartan-fit'],
	[/^step tone/i, 'step-tone'],
	[/^olistic/i, 'olistic-tone'],
	[/^core training/i, 'core-training'],
	[/^dancing fit/i, 'dancing-fit'],
	[/^fit&box/i, 'fit-boxe'],
	[/^g&g/i, 'gg'],
	[/^antalgica/i, 'antalgica'],
	[/^x space/i, 'x-class'],
];
const normalizza = (t: string) => t.toLowerCase().replace(/[&.]/g, ' ').replace(/\s+/g, ' ').trim();

// Le prime frasi del testo, fino a circa 240 caratteri (sempre almeno la prima).
function sintesi(html: string): string {
	const testo = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
	const frasi = testo.split(/(?<=[.!?])\s+/);
	let out = frasi[0] ?? '';
	for (const f of frasi.slice(1)) {
		if ((out + ' ' + f).length > 240) break;
		out += ' ' + f;
	}
	return out;
}

// Dati del pop-up di ogni corso usato nel planning, per chiave "slug#blocco".
type Corso = { titolo: string; sintesi: string; durata: string; href: string; img: { src: string; srcset?: string }; video: string | null };
const CORSI: Record<string, Corso> = {};

// Link e chiave del pop-up di una lezione. Nelle pagine con piu' corsi (Acqua Gym) si sceglie il blocco
// che porta il nome della lezione; nelle altre il primo blocco e' la scheda del corso.
const scheda = (nome: string): { href: string; chiave: string } | undefined => {
	const slug = REGOLE.find(([re]) => re.test(nome))?.[1];
	const pagina = slug && perSlug[slug];
	if (!pagina) return undefined;
	let indice = 0;
	if (pagina.blocchi.length > 1) {
		const n = normalizza(nome);
		indice = pagina.blocchi.findIndex((b: any) => normalizza(b.titolo ?? '').startsWith(n));
		if (indice < 0) return undefined;
	}
	const b = pagina.blocchi[indice];
	const chiave = `${slug}#${indice}`;
	if (!CORSI[chiave]) {
		CORSI[chiave] = {
			titolo: nome,
			sintesi: sintesi(b.descrizioneHtml ?? ''),
			durata: b.dettagli?.find((d: { icona: string | null }) => d.icona?.includes('clock'))?.testo ?? '',
			href: `/${slug}`,
			img: imgSources(pagina.hero.immagine),
			video: b.video ?? null,
		};
	}
	return { href: `/${slug}`, chiave };
};

const sedi = planning.sedi;
---

<div class="pl" data-pl>
	<div class="pl__barra">
		<div class="pl__sedi" role="tablist" aria-label="Sede">
			{
				sedi.map((s, i) => (
					<button type="button" role="tab" class:list={['pl__sede-tab', { 'is-active': i === 0 }]} id={`pl-sede-${s.slug}`} aria-controls={`pl-${s.slug}`} aria-selected={i === 0 ? 'true' : 'false'} data-sede={s.slug}>
						{s.nome}
					</button>
				))
			}
		</div>

		<div class="pl__filtro" role="group" aria-label="Filtra per tipo di lezione">
			<button type="button" class="pl__tipo is-on" aria-pressed="true" data-tipo="all">Tutte</button>
			{
				Object.entries(TIPI).map(([id, nome]) => (
					<button type="button" class="pl__tipo" aria-pressed="false" data-tipo={id}>
						<span class={`pl__dot pl__dot--${id}`} aria-hidden="true" />
						{nome}
					</button>
				))
			}
		</div>
	</div>

	{
		sedi.map((s, si) => (
			<section class:list={['pl__sede', { 'is-active': si === 0 }]} id={`pl-${s.slug}`} role="tabpanel" aria-labelledby={`pl-sede-${s.slug}`} data-sede-panel={s.slug}>
				<p class="pl__meta">
					<span>{s.validita}</span>
					<a href={s.pdf} target="_blank" rel="noopener">
						Scarica il PDF
					</a>
				</p>

				<div class="pl__box" data-giorni>
					<div class="pl__giorni" role="tablist" aria-label={`Giorno della settimana - ${s.nome}`}>
						{GIORNI.map((g, i) => (
							<button type="button" role="tab" class:list={['pl__giorno', { 'is-active': i === 0, 'is-vuoto': s.giorni[g.id].length === 0 }]} id={`pl-${s.slug}-tab-${g.id}`} aria-controls={`pl-${s.slug}-${g.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-giorno={g.id}>
								<span aria-hidden="true">{g.id}</span>
								<span class="sr-only">{g.nome}</span>
							</button>
						))}
					</div>

					<div class="pl__pannelli">
						{GIORNI.map((g, i) => (
							<section class:list={['pl__pannello', { 'is-active': i === 0 }]} id={`pl-${s.slug}-${g.id}`} role="tabpanel" aria-labelledby={`pl-${s.slug}-tab-${g.id}`} data-giorno={g.id}>
								<h3 class="pl__titolo-giorno">{g.nome}</h3>
								<ul class="pl__lista">
									{s.giorni[g.id].map((l) => {
										const info = scheda(l.nome);
										return (
											<li class="lez" data-tipo={l.tipo}>
												<span class="lez__ora">
													{l.ora}
													<span class="lez__fine">{l.fine}</span>
												</span>
												<span class="lez__corpo">
													{info ? (
														<a class="lez__nome" href={info.href} data-corso={info.chiave} aria-haspopup="dialog">
															{l.nome}
														</a>
													) : (
														<span class="lez__nome">{l.nome}</span>
													)}
													<span class="lez__meta">
														{[l.istruttore, l.sala, l.nota].filter(Boolean).join(' · ')}
													</span>
												</span>
												<span class="lez__tipo">
													<span class={`pl__dot pl__dot--${l.tipo}`} aria-hidden="true" />
													{TIPI[l.tipo]}
												</span>
											</li>
										);
									})}
								</ul>
								<p class="pl__vuoto" role="status" hidden>
									Nessuna lezione di questo tipo in questo giorno.
								</p>
							</section>
						))}
					</div>

					<div class="pl__nav">
						<button type="button" class="pl__freccia" data-prev aria-label="Giorno precedente">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<polyline points="15 18 9 12 15 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<span class="pl__etichetta" data-label aria-live="polite">{GIORNI[0].nome}</span>
						<button type="button" class="pl__freccia" data-next aria-label="Giorno successivo">
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
								<polyline points="9 18 15 12 9 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
					</div>
				</div>
			</section>
		))
	}
</div>

<!-- Pop-up del corso: lo riempie lo script con i dati della lezione toccata -->
<script is:inline type="application/json" id="corsi-dati" set:html={JSON.stringify(CORSI).replace(/</g, '\\u003c')} />

<dialog id="corso-modal" class="cm" aria-labelledby="cm-nome">
	<button type="button" class="cm__close" aria-label="Chiudi" data-cm-close>
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
			<path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
		</svg>
	</button>
	<div class="cm__media">
		<img class="cm__img" alt="" />
		<video class="cm__video" muted loop playsinline preload="none" hidden></video>
	</div>
	<div class="cm__body">
		<p class="cm__meta">
			<span class="cm__cat" data-cm-cat></span>
			<span class="cm__dur" data-cm-dur></span>
		</p>
		<h3 class="cm__nome" id="cm-nome"></h3>
		<p class="cm__sintesi" data-cm-sintesi></p>
		<a class="btn cm__link" href="/" data-cm-link>Scopri il corso <span aria-hidden="true">→</span></a>
	</div>
</dialog>

<script>
	// @ts-nocheck - script vanilla: gli elementi ci sono sempre, i tipi DOM generici qui danno solo falsi errori
	const GIORNI = ['LUN', 'MAR', 'MER', 'GIO', 'VEN', 'SAB', 'DOM'];
	const NOMI = ['Lunedì', 'Martedì', 'Mercoledì', 'Giovedì', 'Venerdì', 'Sabato', 'Domenica'];
	const oggi = GIORNI[(new Date().getDay() + 6) % 7];

	document.querySelectorAll('[data-pl]').forEach((pl) => {
		let tipo = 'all';
		let giorno = oggi;

		const sedeTabs = [...pl.querySelectorAll('.pl__sede-tab')];
		const sedePanels = [...pl.querySelectorAll('.pl__sede')];
		const tipoBtns = [...pl.querySelectorAll('.pl__tipo')];

		const aggiornaGiorno = () => {
			pl.querySelectorAll('[data-giorni]').forEach((box) => {
				box.querySelectorAll('.pl__giorno').forEach((t) => {
					const on = t.dataset.giorno === giorno;
					t.classList.toggle('is-active', on);
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
				});
				box.querySelectorAll('.pl__pannello').forEach((p) => {
					const on = p.dataset.giorno === giorno;
					p.classList.toggle('is-active', on);
					// filtro per tipo: nasconde le lezioni degli altri tipi
					let visibili = 0;
					p.querySelectorAll('.lez').forEach((l) => {
						const mostra = tipo === 'all' || l.dataset.tipo === tipo;
						l.hidden = !mostra;
						if (mostra) visibili++;
					});
					p.querySelector('.pl__vuoto').hidden = visibili > 0;
				});
				box.querySelector('[data-label]').textContent = NOMI[GIORNI.indexOf(giorno)];
			});
		};

		const scegliSede = (slug) => {
			sedeTabs.forEach((t) => {
				const on = t.dataset.sede === slug;
				t.classList.toggle('is-active', on);
				t.setAttribute('aria-selected', String(on));
			});
			sedePanels.forEach((p) => p.classList.toggle('is-active', p.dataset.sedePanel === slug));
		};

		sedeTabs.forEach((t) => t.addEventListener('click', () => scegliSede(t.dataset.sede)));

		tipoBtns.forEach((b) =>
			b.addEventListener('click', () => {
				tipo = b.dataset.tipo;
				tipoBtns.forEach((x) => {
					const on = x === b;
					x.classList.toggle('is-on', on);
					x.setAttribute('aria-pressed', String(on));
				});
				aggiornaGiorno();
			})
		);

		pl.querySelectorAll('.pl__giorno').forEach((t) => {
			t.addEventListener('click', () => {
				giorno = t.dataset.giorno;
				aggiornaGiorno();
			});
			// frecce sinistra/destra sui tab
			t.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
				const d = e.key === 'ArrowRight' ? 1 : -1;
				giorno = GIORNI[(GIORNI.indexOf(giorno) + d + 7) % 7];
				aggiornaGiorno();
				pl.querySelector(`.pl__sede.is-active .pl__giorno[data-giorno="${giorno}"]`)?.focus();
			});
		});

		const sposta = (d) => {
			giorno = GIORNI[(GIORNI.indexOf(giorno) + d + 7) % 7];
			aggiornaGiorno();
		};
		pl.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => sposta(-1)));
		pl.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => sposta(1)));

		aggiornaGiorno();
	});

	// ---- Pop-up del corso: immagine (o video), durata e sintesi -------------------------------
	// Senza JavaScript le lezioni restano normali link alla scheda del corso.
	const dati = JSON.parse(document.getElementById('corsi-dati')?.textContent ?? '{}');
	const dlg = document.getElementById('corso-modal');
	if (dlg) {
		const img = dlg.querySelector('.cm__img');
		const video = dlg.querySelector('.cm__video');
		const nome = dlg.querySelector('.cm__nome');
		const sintesi = dlg.querySelector('[data-cm-sintesi]');
		const cat = dlg.querySelector('[data-cm-cat]');
		const dur = dlg.querySelector('[data-cm-dur]');
		const link = dlg.querySelector('[data-cm-link]');
		const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const ferma = () => {
			video.pause();
			video.removeAttribute('src');
			video.load(); // interrompe un eventuale scaricamento
			video.hidden = true;
			document.body.classList.remove('lf-locked');
		};

		const apri = (a) => {
			const c = dati[a.dataset.corso ?? ''];
			if (!c) {
				location.href = a.href;
				return;
			}
			nome.textContent = c.titolo;
			sintesi.textContent = c.sintesi;
			cat.textContent = a.closest('.lez')?.querySelector('.lez__tipo')?.textContent.trim() ?? '';
			dur.textContent = c.durata;
			link.href = c.href;
			img.src = c.img.src;
			if (c.img.srcset) {
				img.srcset = c.img.srcset;
				img.sizes = '(max-width: 560px) 92vw, 480px';
			} else img.removeAttribute('srcset');
			document.body.classList.add('lf-locked');
			dlg.showModal();
			// Il video parte solo all'apertura (pesa qualche MB) e solo senza "riduci movimento":
			// finche' non e' pronto si vede la foto.
			if (c.video && !ridotto) {
				video.src = c.video;
				video.addEventListener(
					'canplay',
					() => {
						video.hidden = false;
						video.play().catch(() => {});
					},
					{ once: true }
				);
				video.load();
			}
		};

		document.querySelectorAll('[data-pl] a[data-corso]').forEach((a) =>
			a.addEventListener('click', (e) => {
				// Apri in una nuova scheda (ctrl/cmd/maiusc/tasto centrale): resta il link normale.
				if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
				e.preventDefault();
				apri(a);
			})
		);
		dlg.querySelector('[data-cm-close]').addEventListener('click', () => dlg.close());
		// Un tocco sullo sfondo scuro (il target e' il dialog stesso) chiude il pop-up.
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close();
		});
		dlg.addEventListener('close', ferma);
	}
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	/* ---- Barra: sede a sinistra, filtro a destra ---- */
	.pl__barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		margin-bottom: 20px;
	}

	.pl__sedi {
		display: flex;
		gap: 8px;
	}

	.pl__sede-tab {
		min-height: 44px;
		padding: 10px 22px;
		border: 2px solid var(--accent);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--accent);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: background var(--dur-base), color var(--dur-base);
	}

	.pl__sede-tab:hover {
		background: rgba(255, 230, 0, 0.14);
	}

	.pl__sede-tab.is-active {
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.pl__sede-tab:focus-visible,
	.pl__tipo:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: 2px;
	}

	.pl__filtro {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.pl__tipo {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 40px;
		padding: 8px 16px;
		border: 1px solid var(--border-on-dark);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-on-dark);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 700;
		cursor: pointer;
		transition: background var(--dur-base), border-color var(--dur-base);
	}

	.pl__tipo:hover {
		border-color: var(--text-on-dark);
	}

	.pl__tipo.is-on {
		border-color: var(--text-on-dark);
		background: rgba(255, 255, 255, 0.12);
	}

	.pl__dot {
		flex: none;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
	}

	.pl__dot--acqua {
		background: #4cc3ff;
	}

	.pl__dot--sala {
		background: var(--accent);
	}

	.pl__dot--outdoor {
		background: #7bdc6a;
	}

	/* ---- Pannello della sede: con JavaScript se ne vede una sola ---- */
	:global(html.js) .pl__sede:not(.is-active) {
		display: none;
	}

	.pl__sede + .pl__sede {
		margin-top: 48px;
	}

	.pl__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 20px;
		margin: 0 0 16px;
		font-size: var(--text-sm);
		color: var(--text-on-dark);
	}

	.pl__meta a {
		font-weight: 700;
		color: var(--text-on-dark);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1.5px;
	}

	.pl__meta a:hover,
	.pl__meta a:focus-visible {
		color: var(--accent);
	}

	/* ---- Riquadro con tab dei giorni, elenco e frecce ---- */
	.pl__box {
		border: 1px solid var(--border-on-dark);
		border-bottom: 3px solid var(--accent);
		border-radius: var(--radius);
		overflow: clip;
	}

	:global(html:not(.js)) .pl__sedi,
	:global(html:not(.js)) .pl__filtro,
	:global(html:not(.js)) .pl__giorni,
	:global(html:not(.js)) .pl__nav {
		display: none;
	}

	.pl__giorni {
		display: flex;
		border-bottom: 2px solid var(--accent);
		background: var(--bg-dark-soft);
	}

	.pl__giorno {
		flex: 1;
		min-width: 0;
		min-height: 48px;
		padding: 14px 4px;
		border: 0;
		border-right: 1px solid var(--border-on-dark);
		background: var(--bg-dark-soft);
		color: var(--text-on-dark);
		font: inherit;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 2px;
		text-transform: uppercase;
		cursor: pointer;
		transition: background var(--dur-base), color var(--dur-base);
	}

	.pl__giorno:last-child {
		border-right: 0;
	}

	.pl__giorno:hover {
		background: var(--bg-dark);
	}

	.pl__giorno.is-active {
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.pl__giorno.is-vuoto:not(.is-active) {
		opacity: 0.5;
	}

	.pl__giorno:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: -3px;
	}

	.pl__pannelli {
		background: var(--bg-dark);
	}

	:global(html.js) .pl__pannello:not(.is-active) {
		display: none;
