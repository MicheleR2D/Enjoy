---
/*
 * Un percorso in piu' fasi (es. il nuoto neonatale: 3-12, 13-24, 25-36 mesi): titolo e introduzione
 * in alto, poi le fasi affiancate. Niente card: ogni fase e' una colonna con un filo giallo in
 * cima, l'eta' in grande e il testo sotto. Il titolo di ogni fase arriva dai dati come
 * "PRIMA FASE dai 3 ai 12 mesi": qui lo si divide in nome della fase e fascia d'eta'.
 */
interface Props {
	titolo: string;
	/** Testo introduttivo (HTML gia' ripulito). */
	introHtml?: string;
	fasi: { titolo: string; html: string }[];
	/** "accento": fondo giallo con testo nero (per alternare le sezioni). */
	tone?: 'dark' | 'accento';
	/** Colore della sezione che segue, se diverso dal proprio: in fondo c'e' lo sfumo. */
	sfumoA?: 'nero' | 'accento';
	/** La sezione che precede finisce con uno sfumo: meno spazio in cima. */
	dopoSfumo?: boolean;
}

const { titolo, introHtml, fasi, tone = 'dark', sfumoA, dopoSfumo = false } = Astro.props;
const accentoTone = tone === 'accento';
const coloreSezione = accentoTone ? 'var(--accent)' : 'var(--bg-dark)';
const coloreSuccessivo = sfumoA === 'accento' ? 'var(--accent)' : 'var(--bg-dark)';
const sfumo = !!sfumoA && coloreSezione !== coloreSuccessivo;

// Titolo con le ultime due parole in giallo ("Il percorso in" + "3 fasi").
const parole = titolo.trim().split(/\s+/);
const accento = parole.length > 2 ? parole.splice(-2).join(' ') : null;
const inizio = parole.join(' ');

const prepara = (t: string) => {
	const pulito = t.replace(/[​ ]/g, ' ').trim();
	const m = pulito.match(/^(\S+\s+fase)\s+(.*)$/i);
	const nome = m ? m[1] : pulito;
	const eta = m ? m[2] : '';
	const intervallo = eta.match(/(\d+)\D+(\d+)\s*(mesi|anni)/i);
	return {
		nome: nome.charAt(0).toUpperCase() + nome.slice(1).toLowerCase(),
		numeri: intervallo ? `${intervallo[1]}–${intervallo[2]}` : eta,
		unita: intervallo ? intervallo[3].toLowerCase() : '',
	};
};
---

<section
	class:list={['fasi', 'sez', { 'on-dark': !accentoTone, 'fasi--accento': accentoTone, sfuma: sfumo, 'dopo-sfumo': dopoSfumo }]}
	style={sfumo ? `--da:${coloreSezione};--a:${coloreSuccessivo}` : undefined}
>
	<div class="fasi__inner container-wide">
		<header class="fasi__testata">
			<h2 class="fasi__titolo" data-anim="from-left">
				{
					accento ? (
						<>
							<span>{inizio}</span>{' '}
							<span class="fasi__accento">{accento}</span>
						</>
					) : (
						titolo
					)
				}
			</h2>
			{introHtml && <div class="fasi__intro" data-anim="from-right" data-anim-delay="80" set:html={introHtml} />}
		</header>

		<ol class="fasi__lista" data-fasi>
			{
				fasi.map((f, i) => {
					const { nome, numeri, unita } = prepara(f.titolo);
					return (
						<li class="fase" data-anim="up" data-anim-delay={String(i * 120)}>
							<p class="fase__nome">{nome}</p>
							<p class="fase__eta">
								<span class="fase__numeri">{numeri}</span>
								{unita && <span class="fase__unita">{unita}</span>}
							</p>
							<div class="fase__testo" set:html={f.html} />
						</li>
					);
				})
			}
		</ol>
		<div class="fasi__punti" aria-hidden="true">
			{fasi.map((_, i) => (
				<span class:list={['cb__punto', { 'is-on': i === 0 }]} />
			))}
			<svg class="cb__scorri" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 12h15" />
				<path d="m13 6 6 6-6 6" />
			</svg>
		</div>
	</div>
</section>

<script>
	import { iniziaCarosello } from '../lib/carosello.client';
	document.querySelectorAll<HTMLElement>('.fasi__lista').forEach(iniziaCarosello);
</script>

<style>
	.fasi {
		padding-block: var(--sez-pt, clamp(24px, 3vw, 40px)) var(--sez-pb, clamp(40px, 6vw, 80px));
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	/* Variante gialla: testo nero; la parola in evidenza e' gialla su riquadro nero (come nella CTA finale). */
	.fasi--accento {
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.fasi.fasi--accento .fasi__titolo {
		color: var(--bg-dark-deep);
	}

	.fasi.fasi--accento .fasi__accento {
		display: inline-block;
		padding: 0 0.18em;
		background: var(--bg-dark-deep);
		color: var(--accent);
	}

	.fasi--accento .fase {
		border-top-color: var(--bg-dark-deep);
	}

	.fasi--accento .fase__nome {
		color: var(--bg-dark-deep);
	}

	/* Titolo su una riga e paragrafo sotto, a tutta larghezza. */
	.fasi__testata {
		margin-bottom: clamp(28px, 3.5vw, 48px);
	}

	.fasi .fasi__titolo {
		margin: 0 0 clamp(12px, 1.5vw, 20px);
		color: var(--text-on-dark);
		font-size: clamp(2.2rem, 4vw, 3.5rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		text-transform: none;
	}

	.fasi .fasi__accento {
		color: var(--accent);
	}

	.fasi__intro {
		max-width: 60rem;
		font-size: var(--text-md);
		line-height: 1.6;
	}

	.fasi__intro :global(p) {
		margin: 0;
	}

	.fasi__lista {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(24px, 3vw, 48px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.fase {
		padding-top: 20px;
		border-top: 4px solid var(--accent);
	}

	.fase__nome {
		margin: 0 0 4px;
		font-size: var(--text-base);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.fase__eta {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin: 0 0 18px;
	}

	.fase__numeri {
		font-family: var(--font-heading);
		font-size: clamp(2.6rem, 4.4vw, 4rem);
		font-weight: 900;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.fase__unita {
		font-size: var(--text-lg);
		font-weight: 600;
	}

	.fase__testo {
		font-size: var(--text-md);
		line-height: 1.6;
	}

	.fase__testo :global(p) {
		margin: 0 0 0.8em;
	}

	.fase__testo :global(p:last-child) {
		margin-bottom: 0;
	}

	.fasi__punti {
		display: none;
	}

	/* Telefono: le fasi sono card da scorrere di lato (gialle sul nero, nere sul giallo), con pallini e freccia. */
	@media (max-width: 900px) {
		.fasi__lista {
			display: flex;
			gap: 12px;
			margin-inline: calc(-1 * var(--gutter));
			padding: 4px var(--gutter) 12px;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			touch-action: pan-x pan-y;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--gutter);
			scrollbar-width: none;
		}

		.fasi__lista::-webkit-scrollbar {
			display: none;
		}

		.fasi .fase {
			flex: 0 0 80%;
			scroll-snap-align: start;
			padding: 20px 18px 22px;
			border: 0;
			border-radius: 16px;
			background: var(--accent);
			color: var(--on-accent);
			box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.55);
			scale: 0.94;
			transform-origin: left center;
			transition: scale 0.45s var(--ease-out-crit);
		}

		.fasi .fase.is-attiva,
		.fasi .fase:first-child:not(.is-attiva) {
			scale: 1;
		}

		.fasi .fase__nome {
			color: var(--on-accent);
		}

		.fasi--accento .fase {
			background: var(--bg-dark-deep);
			color: var(--text-on-dark);
		}

		.fasi--accento .fase__nome {
			color: var(--accent);
		}

		.fasi__punti {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 8px;
			margin-top: 6px;
		}

		.fasi__punti .cb__punto {
			width: 8px;
			height: 8px;
			border-radius: 4px;
			background: currentColor;
			opacity: 0.3;
			transition: width 0.3s ease, opacity 0.3s ease;
		}

		.fasi__punti .cb__punto.is-on {
			width: 22px;
			opacity: 1;
		}

		.fasi__punti .cb__scorri {
			margin-left: 6px;
			animation: fasi-scorri 1.4s ease-in-out infinite;
			transition: opacity 0.3s ease;
		}

		.fasi__punti.is-fine .cb__scorri {
			opacity: 0;
			animation: none;
		}

		@keyframes fasi-scorri {
			0%,
			100% {
				transform: translateX(-2px);
			}
			50% {
				transform: translateX(5px);
			}
		}
	}
</style>
