---
/*
 * Hero di una pagina interna: foto a tutta larghezza con velo scuro, titolo grande
 * (con parole che ruotano, se sono piu' d'una) e i pulsanti passati come slot.
 * Va usata con <Layout headerTone="overlay">: la foto passa sotto l'header (fisso,
 * chiaro e un po' trasparente). Alta come la hero della home. Il sottotitolo (un H2 sotto il titolo) c'è solo se lo si passa.
 *
 * Se c'e' `video` (id di un video YouTube) parte in sottofondo, muto e senza controlli,
 * sopra la foto: la foto resta finche' il video non e' pronto e per chi ha ridotto i movimenti.
 *
 *   <PageHero image="/wp-content/uploads/…jpg" title="group" words={['cycling']}>
 *     <a class="btn btn--pillola btn--lg" href="/…">…</a>
 *   </PageHero>
 */
import Img from './Img.astro';
import VideoSfondo from './VideoSfondo.astro';

interface Props {
	image: string;
	title: string;
	/** Parola/e che chiudono il titolo. Se sono piu' di una ruotano (la prima si vede subito). */
	words?: string[];
	/** Frase sotto il titolo (es. "Palestra e piscina a Camuzzago di Bellusco, vicino a Vimercate"): e' un H2. */
	sottotitolo?: string;
	/** Scritta piccola sopra il titolo (es. "2 sale pesi diverse"). */
	eyebrow?: string;
	/** Descrizione della foto (vuota se e' solo decorativa). */
	imageAlt?: string;
	/** Video YouTube di sfondo: id, secondo di partenza e (facoltativo) di fine. */
	video?: { id: string; inizio?: number; fine?: number };
}

const { image, title, words = [], imageAlt = '', video, eyebrow, sottotitolo } = Astro.props;
---

<section class="ph">
	<Img src={image} alt={imageAlt} class="img-cover" sizes="100vw" priority />
	{video && <VideoSfondo id={video.id} inizio={video.inizio} fine={video.fine} />}
	<div class="ph__overlay"></div>
	<div class="ph__content">
		{eyebrow && <p class="ph__eyebrow" data-intro style="--intro-delay: 0s">{eyebrow}</p>}
		<h1 class="display-title ph__title" data-intro style="--intro-delay: 0.1s">
			{title}
			{
				words.length > 0 && (
					<>
						{' '}
						<span class="ph__rot" data-rot={words.length > 1 ? '' : undefined}>
							{words.map((w, i) => (
								<>
									{i > 0 && ' '}
									<span class:list={['ph__word', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
										{w}
									</span>
								</>
							))}
						</span>
					</>
				)
			}
		</h1>
		{sottotitolo && <h2 class="ph__sub" data-intro style="--intro-delay: 0.18s">{sottotitolo}</h2>}
		{
			Astro.slots.has('default') && (
				<div class="ph__actions" data-intro style="--intro-delay: 0.25s">
					<slot />
				</div>
			)
		}
	</div>
</section>

<style>
	.ph {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		/* Stessa altezza della hero della home (HeroCarousel). */
		min-height: 100vh;
		min-height: 100svh;
		padding: calc(var(--header-h) + 32px) var(--gutter) 56px;
		overflow: hidden;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.ph__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.61);
	}

	/* In fondo la foto sfuma nel nero della sezione che segue (come la hero della home). Sta sotto il
	   testo (.ph__content ha z-index 1). */
	.ph::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 72px;
		background: linear-gradient(to bottom, transparent, var(--bg-dark));
		pointer-events: none;
	}

	/* Il bottone principale nella hero e' la pillola GIALLA con testo nero (su foto scura la nera si perdeva):
	   onda gialla e lampo chiaro. Nei blocchi gialli delle pagine la pillola resta nera. */
	.ph__actions :global(.btn--pillola) {
		--btn-border: var(--accent);
		--btn-hover-text: var(--on-accent);
		--onda: rgba(255, 230, 0, 0.4);
		background: var(--accent);
		color: var(--on-accent);
	}

	.ph__actions :global(.btn--pillola)::after {
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.6), transparent);
	}

	/* Larghezza fissa (tutta quella disponibile): senza, il contenitore prende la larghezza del titolo e cambia
	   a ogni parola che ruota, e i bottoni (a tutta larghezza su telefono) si allargano e restringono con lui. */
	.ph__content {
		position: relative;
		z-index: 1;
		width: 100%;
		text-align: center;
	}

	.ph__eyebrow {
		margin: 0 0 12px;
		font-size: clamp(0.95rem, 1.4vw, 1.25rem);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-on-dark);
	}

	/* Come il testo sotto il titolo della hero della home: stessa misura e colore. */
	.ph__sub {
		max-width: 680px;
		margin: 20px auto 0;
		font-size: var(--text-md);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: normal;
		text-transform: none;
		color: var(--text-on-dark);
	}

	.ph__title {
		color: var(--text-on-dark);
		text-transform: uppercase;
	}

	/* Solo la parola attiva occupa spazio nella riga: le altre sono assolute e
	   invisibili, cosi' "titolo + parola" e' sempre centrato come testo normale
	   (stessa tecnica della hero della home). */
	.ph__rot {
		position: relative;
		display: inline-block;
		color: var(--accent);
		white-space: nowrap;
	}

	.ph__word {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transform: translateY(0.35em);
		transition: opacity 0.5s ease, transform 0.6s var(--ease-out-crit);
	}

	.ph__word.is-on {
		position: static;
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.ph__word {
			transition: none;
		}
	}

	.ph__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
		margin-top: 36px;
	}

	/* Su telefono i bottoni stanno uno sotto l'altro, centrati e larghi quanto serve (non a tutta larghezza), con meno
	   padding laterale. */
	@media (max-width: 560px) {
		.ph__actions {
			flex-direction: column;
			align-items: center;
			gap: 12px;
		}

		.ph__actions :global(.btn) {
			padding-inline: 22px;
		}
	}
</style>

<script>
	import { fissaAltezzaTitolo } from '../lib/fissaTitolo.client';

	// Il titolo riserva l'altezza della parola piu' alta (puo' andare a capo): il bottone sotto resta fermo.
	document.querySelectorAll<HTMLElement>('[data-rot]').forEach((rot) => fissaAltezzaTitolo(rot.closest('.ph__title'), '.ph__word'));

	// Fa ruotare le parole del titolo; con "riduci movimento" resta la prima.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLElement>('[data-rot]').forEach((rot) => {
			const parole = [...rot.querySelectorAll<HTMLElement>('.ph__word')];
			let i = 0;
			setInterval(() => {
				parole[i].classList.remove('is-on');
				parole[i].setAttribute('aria-hidden', 'true');
				i = (i + 1) % parole.length;
				parole[i].classList.add('is-on');
				parole[i].removeAttribute('aria-hidden');
			}, 2800);
		});
	}
</script>
