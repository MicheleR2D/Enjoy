---
/*
 * Hero di una pagina interna: foto a tutta larghezza con velo scuro, titolo grande
 * (con parole che ruotano, se sono piu' d'una) e i pulsanti passati come slot.
 * Va usata con <Layout headerTone="overlay">: la foto passa sotto l'header (fisso,
 * chiaro e un po' trasparente). Alta come la hero della home. Nessun sottotitolo.
 *
 * Se c'e' `video` (id di un video YouTube) parte in sottofondo, muto e senza controlli,
 * sopra la foto: la foto resta finche' il video non e' pronto e per chi ha ridotto i movimenti.
 *
 *   <PageHero image="/wp-content/uploads/…jpg" title="group" words={['cycling']}>
 *     <a class="btn btn--lg" href="/…">…</a>
 *   </PageHero>
 */
import Img from './Img.astro';

interface Props {
	image: string;
	title: string;
	/** Parola/e che chiudono il titolo. Se sono piu' di una ruotano (la prima si vede subito). */
	words?: string[];
	/** Descrizione della foto (vuota se e' solo decorativa). */
	imageAlt?: string;
	/** Video YouTube di sfondo: id, secondo di partenza e (facoltativo) di fine. */
	video?: { id: string; inizio?: number; fine?: number };
}

const { image, title, words = [], imageAlt = '', video } = Astro.props;

// Incorporamento in modalita' privacy (youtube-nocookie), muto, in loop, senza controlli.
// Lo carica lo script dopo il caricamento della pagina: non rallenta la hero.
const videoSrc = video
	? `https://www.youtube-nocookie.com/embed/${video.id}?${new URLSearchParams({
			autoplay: '1',
			mute: '1',
			controls: '0',
			loop: '1',
			playlist: video.id,
			playsinline: '1',
			rel: '0',
			disablekb: '1',
			iv_load_policy: '3',
			...(video.inizio ? { start: String(video.inizio) } : {}),
			...(video.fine ? { end: String(video.fine) } : {}),
		})}`
	: null;
---

<section class="ph">
	<Img src={image} alt={imageAlt} class="img-cover" sizes="100vw" priority />
	{
		videoSrc && (
			<div class="ph__video" aria-hidden="true">
				<iframe data-src={videoSrc} title="" tabindex="-1" allow="autoplay; encrypted-media" referrerpolicy="strict-origin-when-cross-origin" />
			</div>
		)
	}
	<div class="ph__overlay"></div>
	<div class="ph__content">
		<h1 class="display-title ph__title" data-intro style="--intro-delay: 0.1s">
			{title}
			{
				words.length > 0 && (
					<>
						{' '}
						<span class="ph__rot" data-rot={words.length > 1 ? '' : undefined}>
							{words.map((w, i) => (
								<>
									{i > 0 && ' '}
									<span class:list={['ph__word', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
										{w}
									</span>
								</>
							))}
						</span>
					</>
				)
			}
		</h1>
		{
			Astro.slots.has('default') && (
				<div class="ph__actions" data-intro style="--intro-delay: 0.25s">
					<slot />
				</div>
			)
		}
	</div>
</section>

<style>
	.ph {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		/* Stessa altezza della hero della home (HeroCarousel). */
		min-height: 100vh;
		min-height: 100svh;
		padding: calc(var(--header-h) + 32px) var(--gutter) 56px;
		overflow: hidden;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	/* Il video riempie la hero come "cover": 16:9 centrato, piu' grande dell'area se serve. */
	.ph__video {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.ph__video iframe {
		position: absolute;
		top: 50%;
		left: 50%;
		width: max(100vw, 177.78svh);
		height: max(56.25vw, 100svh);
		border: 0;
		transform: translate(-50%, -50%);
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.ph__video iframe.is-ready {
		opacity: 1;
	}

	.ph__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.61);
	}

	.ph__content {
		position: relative;
		z-index: 1;
		text-align: center;
	}

	.ph__title {
		color: var(--bg-alt);
		text-transform: uppercase;
	}

	/* Solo la parola attiva occupa spazio nella riga: le altre sono assolute e
	   invisibili, cosi' "titolo + parola" e' sempre centrato come testo normale
	   (stessa tecnica della hero della home). */
	.ph__rot {
		position: relative;
		display: inline-block;
		color: var(--accent);
		white-space: nowrap;
	}

	.ph__word {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		transform: translateY(0.35em);
		transition: opacity 0.5s ease, transform 0.6s var(--ease-out-crit);
	}

	.ph__word.is-on {
		position: static;
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.ph__word {
			transition: none;
		}
	}

	.ph__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
		margin-top: 36px;
	}

	@media (max-width: 900px) {
		.ph {
			min-height: 74vh;
			min-height: 74svh;
		}
	}

	@media (max-width: 560px) {
		.ph__actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>

<script>
	// Video di sfondo: si carica a pagina pronta e compare (con un attimo di attesa, per non
	// mostrare l'interfaccia di YouTube) quando e' partito. Con "riduci movimento" resta la foto.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const avvia = () =>
			document.querySelectorAll<HTMLIFrameElement>('.ph__video iframe[data-src]').forEach((f) => {
				f.addEventListener('load', () => setTimeout(() => f.classList.add('is-ready'), 1200), { once: true });
				f.src = f.dataset.src!;
			});
		if (document.readyState === 'complete') avvia();
		else addEventListener('load', avvia, { once: true });
	}

	// Fa ruotare le parole del titolo; con "riduci movimento" resta la prima.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLElement>('[data-rot]').forEach((rot) => {
			const parole = [...rot.querySelectorAll<HTMLElement>('.ph__word')];
			let i = 0;
			setInterval(() => {
				parole[i].classList.remove('is-on');
				parole[i].setAttribute('aria-hidden', 'true');
				i = (i + 1) % parole.length;
				parole[i].classList.add('is-on');
				parole[i].removeAttribute('aria-hidden');
			}, 2800);
		});
	}
</script>
