---
/*
 * "Richiedi la Prova per:" con le cinque attivita' come elenco puntato (spunte gialle).
 * Stesse parole della frase originale, solo spezzate in voci. Usato nel modal e nella pagina /prova.
 */
const voci = ['Gym Floor', 'Corsi Fitness', 'Corsi Acqua Fitness', 'Nuoto Libero', 'Health Fitness'];
---

<div class="ep">
	<p class="ep__intro">Richiedi la Prova per:</p>
	<ul class="ep__lista">
		{
			voci.map((v) => (
				<li>
					<span class="ep__spunta" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="m5 12.5 4.5 4.5L19 7.5" />
						</svg>
					</span>
					{v}
				</li>
			))
		}
	</ul>
</div>

<style>
	.ep {
		display: grid;
		gap: 12px;
		width: 100%;
	}

	.ep__intro {
		margin: 0;
		line-height: 1.6;
	}

	.ep__lista {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ep__lista li {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		line-height: 1.2;
		color: var(--text-on-dark);
	}

	/* Cerchio giallo con la spunta nera che si "disegna" quando l'elenco compare. */
	.ep__spunta {
		flex: none;
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		box-shadow: 0 0 0 4px rgba(255, 230, 0, 0.18);
	}

	.ep__spunta svg {
		width: 15px;
		height: 15px;
	}

	.ep__spunta path {
		stroke-dasharray: 24;
		stroke-dashoffset: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.ep__spunta path {
			animation: ep-spunta 0.5s ease-out both;
		}
		.ep__lista li:nth-child(2) .ep__spunta path { animation-delay: 0.08s; }
		.ep__lista li:nth-child(3) .ep__spunta path { animation-delay: 0.16s; }
		.ep__lista li:nth-child(4) .ep__spunta path { animation-delay: 0.24s; }
		.ep__lista li:nth-child(5) .ep__spunta path { animation-delay: 0.32s; }
	}

	@keyframes ep-spunta {
		from {
			stroke-dashoffset: 24;
		}
	}
</style>
