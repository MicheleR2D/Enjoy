---
import { megaMenu } from '../data/nav';
import {
	sedi,
	legalLinks,
	formUrl,
	indirizzoCompleto,
	mapsEmbedSrc,
	mapsDirectionsUrl,
	iconeSocial,
	app,
} from '../data/site';
import { stats, formattaNumero } from '../data/stats';
import Img from './Img.astro';

// Stesso contenuto reale del footer originale (template Elementor ID 626): CTA
// "Inizia oggi", app Technogym, sedi, colonne di link, loghi partner e riga
// finale con i dati societari. Al posto del widget a pagamento Elfsight Store
// Locator ci sono le due sedi con mappa statica (stessi indirizzi e telefoni).
const partner = [
	{ src: '/wp-content/uploads/2025/06/logo-ASC-scaled-1.png', alt: 'ASC' },
	{ src: '/wp-content/uploads/2025/06/logo-uisp.png', alt: 'UISP' },
	{ src: '/wp-content/uploads/2025/06/logo-coni.png', alt: 'CONI' },
	{ src: '/wp-content/uploads/2025/06/anif-logo-1.png', alt: 'ANIF' },
	{ src: '/wp-content/uploads/2025/06/Technogym_Logo.svg.png', alt: 'Technogym' },
	{ src: '/wp-content/uploads/2025/06/Starpool-logo.png', alt: 'Starpool' },
	{ src: '/wp-content/uploads/2026/04/LES-MILLS-LOGO-BLACK-scaled.png', alt: 'Les Mills' },
];

const info = [
	{ href: '/orari', label: 'Planning settimanale' },
	...legalLinks.map((l) => ({ href: l.href, label: l.label })),
];

// Stessi numeri della sezione contatori della home: qui fanno da prova sociale
// accanto alla CTA.
const provaSociale = stats.map((x) => ({ numero: formattaNumero(x.target) + x.suffisso, etichetta: x.breve }));

const colonneFoto = [
	[
		'/wp-content/uploads/2025/06/Gym-Floor-Camuzzago-3-scaled.jpg',
		'/wp-content/uploads/2025/06/Piscina-Meda-2-scaled.jpg',
		'/wp-content/uploads/2025/06/Wellness-Meda-2-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/06/Piscina-Meda-4-scaled.jpg',
		'/wp-content/uploads/2025/06/Sala-Pesi-Meda-1-scaled.jpg',
		'/wp-content/uploads/2025/06/Piscina-Camuzzago-4-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/06/Outdoor-Meda-1-scaled.jpg',
		'/wp-content/uploads/2025/06/Gym-Floor-Camuzzago-2-scaled.jpg',
		'/wp-content/uploads/2025/06/Piscina-Camuzzago-8-scaled.jpg',
	],
];
---

<footer class="ft">
	<section class="cta-final" aria-labelledby="cta-final-title" id="prova">
		<div class="cta-final__content">
			<p class="pill pill--dark cta-final__eyebrow" data-anim="pop">Inizia oggi!</p>
			<h2 class="display-title cta-final__title" id="cta-final-title" data-anim="up" data-anim-delay="120">
				Prova <span class="cta-final__title-accent">ora</span><br />i nostri centri
			</h2>
			<p class="cta-final__lead" data-anim="up" data-anim-delay="240">
				Lascia i tuoi dati: ti ricontattiamo noi per organizzare la tua prova a Meda o a Camuzzago.
			</p>

			<ul class="cta-final__proof">
				{
					provaSociale.map((p, i) => (
						<li data-anim="up" data-anim-delay={String(360 + i * 100)}>
							<strong>{p.numero}</strong>
							<span>{p.etichetta}</span>
						</li>
					))
				}
			</ul>

			<div class="cta-final__actions" data-anim="up" data-anim-delay="700">
				<a class="btn btn--outline btn--lg cta-final__btn" href={formUrl('prova', 'Footer')} target="_blank" rel="noopener">
					Richiedi ora <span class="cta-final__btn-arrow" aria-hidden="true">→</span>
				</a>
			</div>
		</div>

		<div class="cta-final__wall" aria-hidden="true" data-anim="from-right">
			{
				colonneFoto.map((colonna, i) => (
					<div class={`cta-final__col ${i === 1 ? 'cta-final__col--down' : ''}`}>
						<div class="cta-final__track">
							{[...colonna, ...colonna].map((src) => (
								<Img src={src} sizes="(max-width: 900px) 30vw, 14vw" />
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="ft-app" aria-labelledby="ft-app-title">
		<Img src="/wp-content/uploads/2025/05/IMG_7567-scaled-1.jpg" alt="" class="img-cover" sizes="100vw" />
		<div class="ft-app__veil"></div>
		<div class="ft-app__content" data-anim="up">
			<h2 class="ft-app__title" id="ft-app-title">{app.titolo}</h2>
			<p>
				Prenota comodamente dall'ufficio o da casa tua i tuoi corsi e monitora le tue attività. I tuoi progressi sempre
				consultabili grazie alla App Technogym, uno strumento di allenamento potentissimo per avere sempre a disposizione i
				tuoi esercizi e i tuoi risultati, sia quando sei in palestra, sia quando sei altrove.
			</p>
			<div class="ft-app__stores">
				<a class="btn btn--light" href={app.appStore} target="_blank" rel="noopener">App Store</a>
				<a class="btn btn--light" href={app.googlePlay} target="_blank" rel="noopener">Google Play</a>
			</div>
		</div>
		<Img src="/wp-content/uploads/2025/06/Nuova-app-Technogym.png" alt="App Technogym" class="ft-app__img" sizes="(max-width: 900px) 70vw, 32vw" />
	</section>

	<section class="sedi" id="sedi" aria-labelledby="sedi-title">
		<div class="sedi__head">
			<p class="pill sedi__eyebrow" data-anim="pop">Dove siamo</p>
			<h2 class="display-title sedi__title" id="sedi-title" data-anim="up" data-anim-delay="120">
				Vieni a <span class="sedi__title-accent">trovarci</span>
			</h2>
		</div>

		<div class="sedi__grid">
			{
				sedi.map((s, i) => (
					<article class="sede" data-anim="up" data-anim-delay={String(i * 150)}>
						<div class="sede__map">
							{/* La mappa di Google si carica solo al clic: prima Google non riceve dati ne' imposta cookie. */}
							<iframe
								data-src={mapsEmbedSrc(s)}
								title={`Mappa - Enjoy Club ${s.nome}, ${indirizzoCompleto(s)}`}
								referrerpolicy="no-referrer-when-downgrade"
							/>
							<button type="button" class="sede__map-load" data-map-load>
								<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
									<path
										fill="currentColor"
										d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
									/>
								</svg>
								<span class="sede__map-load-titolo">Mostra la mappa</span>
								<span class="sede__map-load-nota">Caricando la mappa i dati vengono inviati a Google</span>
							</button>
						</div>
						<div class="sede__body">
							<h3 class="sede__nome">{s.nome}</h3>
							<address class="sede__info">
								<p>{s.via}<br />{s.cap} {s.citta}</p>
								<p>
									<a href={s.telefonoHref}>Tel. {s.telefono}</a>
									{s.email && (
										<>
											<br />
											<a href={`mailto:${s.email}`}>{s.email}</a>
										</>
									)}
								</p>
							</address>
							<div class="sede__cta">
								<a class="btn btn--light btn--sm" href={mapsDirectionsUrl(s)} target="_blank" rel="noopener">
									Indicazioni
								</a>
								<a class="btn btn--sm" href={s.planningPdf} target="_blank" rel="noopener">
									Scarica gli orari
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<div class="ft-main">
		<div class="ft-brand" data-anim="up">
			<img class="ft-brand__logo" src="/wp-content/uploads/2025/05/logo_enjoy_club_negativo.png" alt="Enjoy Club" height="56" />
			<p class="ft-brand__blurb">
				Enjoy Club è il tuo punto di riferimento per fitness, benessere e sport in Brianza. Allenati nelle sedi di Meda e
				Camuzzago con attrezzature all'avanguardia, corsi per ogni livello e un'offerta completa per adulti e bambini.
			</p>
			<div class="ft-social">
				{
					sedi.flatMap((s) =>
						s.social
							.filter((x) => x.label !== 'YouTube')
							.map((x) => (
								<a
									class="ft-social__btn"
									href={x.href}
									target="_blank"
									rel="noopener"
									aria-label={`Enjoy Club ${s.nome} su ${x.label}`}
									title={`${x.label} ${s.nome}`}
								>
									<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={iconeSocial[x.label]} />
								</a>
							))
					)
				}
				<a
					class="ft-social__btn"
					href={sedi[0].social.find((x) => x.label === 'YouTube')?.href}
					target="_blank"
					rel="noopener"
					aria-label="Enjoy Club su YouTube"
					title="YouTube"
				>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={iconeSocial.YouTube} />
				</a>
			</div>
		</div>

		{
			megaMenu.map((colonna, i) => (
				<nav class="ft-col" aria-label={colonna.titolo} data-anim="up" data-anim-delay={String(80 + i * 80)}>
					<p class="ft-heading">{colonna.titolo}</p>
					<ul class="ft-links">
						{colonna.voci.map((voce) => (
							<li>
								<a href={voce.href}>{voce.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}

		<nav class="ft-col" aria-label="Info" data-anim="up" data-anim-delay="400">
			<p class="ft-heading">Info</p>
			<ul class="ft-links">
				{
					info.map((l) => (
						<li>
							<a href={l.href}>{l.label}</a>
						</li>
					))
				}
				<li>
					<a href={formUrl('contatto', 'Footer')} target="_blank" rel="noopener">Contattaci</a>
				</li>
			</ul>
		</nav>
	</div>

	<section class="ft-loghi" aria-label="Partner e istituzioni">
		<p class="ft-heading">Partner e istituzioni</p>
		<ul class="ft-tiles">
			{
				partner.map((p, i) => (
					<li class="ft-tile" data-anim="up" data-anim-delay={String(i * 50)}>
						<img src={p.src} alt={p.alt} loading="lazy" />
					</li>
				))
			}
		</ul>
	</section>

	<div class="ft-bottom">
		{
			sedi.map((s) => (
				<div class="ft-bottom__row">
					<p>
						© {new Date().getFullYear()} {s.ragioneSociale} · {indirizzoCompleto(s)} · Tel. {s.telefono} · P.IVA {s.piva} · RAE{' '}
						{s.rae} · Capitale sociale {s.capitaleSociale}
					</p>
					<ul class="ft-legal">
						<li>
							<a href={s.contributiPdf} target="_blank" rel="noopener">
								Contributi pubblici {s.nome}
							</a>
						</li>
					</ul>
				</div>
			))
		}
		<div class="ft-bottom__row">
			<p>Sito web per la Propaganda dell'Attività Fisica Sportiva Dilettantistica</p>
			<div class="ft-firma">
				<span>Powered by</span>
				<a href="https://ready2digital.it" target="_blank" rel="noopener">
					<img src="/wp-content/uploads/2026/10/logor2d.png" alt="Ready 2 Digital" height="16" />
				</a>
			</div>
		</div>
	</div>
</footer>

<script>
	// Carica la mappa solo quando la persona lo chiede.
	document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((bottone) => {
		bottone.addEventListener('click', () => {
			const iframe = bottone.parentElement?.querySelector<HTMLIFrameElement>('iframe[data-src]');
			if (iframe) iframe.src = iframe.dataset.src ?? '';
			bottone.remove();
		});
	});
</script>

<style>
	.ft {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.ft h2 {
		color: var(--text-on-dark);
	}

	/* --- CTA principale del sito: testo a sinistra, muro di foto a destra --- */
	/* Alta esattamente una schermata, al netto dell'header fisso (--screen-h). */
	.cta-final {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		height: var(--screen-h);
		min-height: 560px;
		overflow: hidden;
		background: var(--accent);
		color: var(--text);
	}

	.cta-final__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 60px 72px 60px var(--gutter);
	}

	.cta-final__eyebrow {
		align-self: flex-start;
		margin: 0 0 20px;
	}

	.ft .cta-final__title {
		color: var(--text);
	}

	/* Sul giallo il bianco non si legge: la parola in evidenza e' gialla su riquadro nero. */
	.cta-final__title-accent {
		display: inline-block;
		padding: 0 0.18em;
		background: var(--bg-dark-deep);
		color: var(--accent);
		font-style: italic;
	}

	.cta-final__lead {
		max-width: 30rem;
		margin: 24px 0 0;
		font-size: var(--text-md);
		line-height: 1.5;
	}

	.cta-final__proof {
		display: grid;
		grid-template-columns: repeat(3, auto);
		justify-content: start;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}

	.cta-final__proof li {
		display: flex;
		flex-direction: column;
		padding: 0 24px;
		border-left: 1px solid var(--text);
	}

	.cta-final__proof li:first-child {
		padding-left: 0;
		border-left: none;
	}

	.cta-final__proof strong {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 2.25rem);
		font-weight: 900;
		line-height: 1;
		color: var(--text);
	}

	.cta-final__proof span {
		margin-top: 6px;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.cta-final__actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px 28px;
		margin-top: 32px;
	}

	/* Colore e taglia: .btn--light .btn--lg (globali). Qui solo freccia e anello pulsante. */
	.cta-final__btn {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		letter-spacing: 0.04em;
		animation: cta-pulse 2.4s ease-out infinite;
	}

	.cta-final__btn-arrow {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-crit);
	}

	.cta-final__btn:hover .cta-final__btn-arrow {
		transform: translateX(6px);
	}

	/* Anello che si espande intorno al bottone: attira l'occhio sulla CTA
	   senza muovere il bottone stesso. */
	@keyframes cta-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.35);
		}
		70%,
		100% {
			box-shadow: 0 0 0 16px rgba(0, 0, 0, 0);
		}
	}

	/* Tre colonne verticali di foto: quella centrale scorre al contrario.
	   La maschera le fa sfumare nel giallo in alto e in basso. */
	.cta-final__wall {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
		padding-right: var(--gutter);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
	}

	.cta-final__track {
		animation: cta-scroll-up 38s linear infinite;
	}

	.cta-final__col--down .cta-final__track {
		animation-name: cta-scroll-down;
	}

	.cta-final__wall:hover .cta-final__track {
		animation-play-state: paused;
	}

	.cta-final__track img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		margin-bottom: 14px;
		object-fit: cover;
		border-radius: 14px;
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
	}

	@keyframes cta-scroll-up {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-50%);
		}
	}

	@keyframes cta-scroll-down {
		from {
			transform: translateY(-50%);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-final__btn,
		.cta-final__track {
			animation: none;
		}
	}

	/* In colonna: testo sopra, le foto riempiono lo spazio rimasto fino a
	   fine schermata. */
	@media (max-width: 900px) {
		.cta-final {
			display: flex;
			flex-direction: column;
			min-height: 0;
		}

		.cta-final__content {
			padding: 36px var(--gutter) 24px;
		}

		.cta-final__lead {
			margin-top: 16px;
		}

		.cta-final__proof {
			grid-template-columns: repeat(2, auto);
			row-gap: 16px;
			margin-top: 20px;
		}

		.cta-final__proof li:nth-child(3) {
			padding-left: 0;
			border-left: none;
		}

		.cta-final__actions {
			margin-top: 24px;
		}

		.cta-final__wall {
			flex: 1;
			min-height: 140px;
			padding-inline: var(--gutter);
		}
	}

	@media (max-width: 560px) {
		.cta-final__btn {
			width: 100%;
			justify-content: center;
		}
	}


	/* --- Colonne: brand + link del menu + info --- */
	.ft-main {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) repeat(5, minmax(0, 1fr));
		gap: 40px;
		padding: 64px var(--gutter) 48px;
	}

	.ft-brand__logo {
		display: block;
		height: 40px;
		width: auto;
		margin-bottom: 20px;
	}

	.ft-brand__blurb {
		max-width: 24rem;
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--text-on-dark);
	}

	.ft-social {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
	}

	.ft-social__btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		color: var(--text-on-dark);
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.ft-social__btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.ft-heading {
		margin: 0 0 16px;
		font-family: var(--font-heading);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.ft-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.ft-links a,
	.ft-links button {
		font-size: var(--text-sm);
		color: var(--text-on-dark);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.ft-links button {
		padding: 0;
		border: 0;
		background: none;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
	}

	.ft-links a:hover,
	.ft-links button:hover {
		color: var(--accent);
	}


	/* --- Loghi: un'unica riga ferma, tutti nella stessa card bianca, a
	   colori e alla stessa scala. Su schermi stretti la riga si scorre a
	   mano invece di andare a capo. */
	.ft-loghi {
		padding: 40px var(--gutter);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	.ft-tiles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.ft-tiles::-webkit-scrollbar {
		display: none;
	}

	.ft-tile {
		flex: 1 1 0;
		min-width: 76px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8px 10px;
		background: var(--bg);
		border-radius: var(--radius);
	}

	.ft-tile a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	.ft-tile img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	/* --- Riga finale --- */
	.ft-bottom {
		display: grid;
		gap: 12px;
