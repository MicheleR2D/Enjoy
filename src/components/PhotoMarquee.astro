---
// Striscia fotografica a scorrimento continuo, senza soluzione di
// continuità (loop infinito), con sfumatura ai bordi.
import Img from './Img.astro';

interface Photo {
	src: string;
	alt?: string;
}
interface Props {
	images: Photo[];
	height?: number;
	cardWidth?: number;
	speed?: number; // px al secondo
}
const { images, height = 320, cardWidth = 460, speed = 60 } = Astro.props;

const gap = 8;
const groupWidth = images.length * cardWidth + images.length * gap;
const duration = Math.round(groupWidth / speed);
---

<div class="pm" style={`--pm-w:${cardWidth}px; --pm-h:${height}px; --pm-gap:${gap}px`}>
	<div class="pm__track" style={`--pm-duration:${duration}s`}>
		{
			[0, 1].map((copy) => (
				<div class="pm__group" aria-hidden={copy === 1 ? 'true' : undefined}>
					{images.map((img) => (
						<Img
							src={img.src}
							alt={copy === 1 ? '' : img.alt || ''}
							sizes={`(max-width: 560px) 260px, (max-width: 900px) 340px, ${cardWidth}px`}
						/>
					))}
				</div>
			))
		}
	</div>
</div>

<style>
	.pm {
		overflow: hidden;
		padding: 8px 0;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}

	.pm__track {
		display: flex;
		width: max-content;
		animation: pm-scroll var(--pm-duration) linear infinite;
	}

	.pm:hover .pm__track {
		animation-play-state: paused;
	}

	.pm__group {
		display: flex;
		flex-shrink: 0;
		gap: var(--pm-gap);
		padding-right: var(--pm-gap);
	}

	/* Le foto sono figli di <Img>, fuori dallo scope di questo componente: :global. */
	.pm__group :global(img) {
		flex-shrink: 0;
		width: var(--pm-w);
		height: var(--pm-h);
		object-fit: cover;
		display: block;
		border-radius: var(--radius-lg);
	}

	@keyframes pm-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 900px) {
		.pm__track {
			--pm-w: 340px;
			--pm-h: 240px;
		}
	}

	@media (max-width: 560px) {
		.pm__track {
			--pm-w: 260px;
			--pm-h: 200px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pm__track {
			animation: none;
		}
		.pm {
			overflow-x: auto;
		}
	}
</style>
