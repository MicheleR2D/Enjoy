---
/*
 * Un blocco di una scheda (corso o servizio): video, foto o carosello da un lato;
 * titolo, descrizione, durata, "cosa portare" e barre di intensita' dall'altro.
 * Una pagina ha uno o piu' blocchi: `reverse` li alterna sinistra/destra. Senza
 * media il testo occupa una colonna di lettura.
 *
 * `tone="accento"`: stesso layout su fondo giallo, con testo nero (come le fasce
 * gialli della home).
 *
 *   <CourseBlock blocco={…} fallbackImage="/wp-content/uploads/…jpg" reverse />
 */
import Img from './Img.astro';
import IconaChip from './IconaChip.astro';
import ImageSlider from './ImageSlider.astro';
import SectionTitle from './SectionTitle.astro';

interface Blocco {
	/** Ancora (#id) per i collegamenti interni della pagina. */
	id?: string | null;
	titolo: string | null;
	sottotitolo: string | null;
	descrizioneHtml: string;
	video?: string | null;
	/** Una foto, o piu' foto in carosello. */
	immagini?: string[];
	/** Testo alternativo delle foto (descrive l'ambiente, es. "Piscine di Enjoy Club Camuzzago"). Assente = foto decorative. */
	alt?: string;
	/** "contain" per i loghi: mostrati interi su fondo bianco invece di essere ritagliati. */
	adattamento?: 'cover' | 'contain';
	dettagli: { testo: string; icona: string | null }[];
	/** Riquadro di approfondimento sotto la descrizione (es. orari e modalita'). */
	extra?: { titolo: string; html: string } | null;
	portareTitolo: string | null;
	portare: { etichetta: string; immagine: string | null }[];
	intensita: { etichetta: string; valore: number }[];
	/** Pulsanti sotto il testo (es. "Scopri la sede", "Medical Center"). */
	pulsanti?: { testo: string; href: string; esterno?: boolean }[];
}

interface Props {
	blocco: Blocco;
	/** Foto da usare se il blocco non ha ne' video ne' foto (le schede corso). */
	fallbackImage?: string;
	/** Media a destra e testo a sinistra. */
	reverse?: boolean;
	/** Senza spazio sotto: un elenco di ancore segue subito dopo il blocco. */
	compatto?: boolean;
	/** Sfondo: "dark" nero, "soft" grigio scuro, "accento" giallo con testo nero
	 *  (per alternare i blocchi). */
	tone?: 'dark' | 'soft' | 'accento';
	/** Colore della sezione che segue, se diverso dal proprio: in fondo al blocco c'e' lo sfumo. */
	sfumoA?: 'nero' | 'accento';
	/** La sezione che precede finisce con uno sfumo: meno spazio in cima (36px pieni). */
	dopoSfumo?: boolean;
	/** Testo diviso in schede (src/lib/schede.js): card a scorrimento su telefono, griglia su desktop. Pagine sede. */
	schede?: { titolo?: string; html: string }[];
	/** Pagine sede: su telefono la foto sta tra il titolo e il paragrafo, piu' grande; paragrafo a 16px. */
	fotoCentro?: boolean;
	/** Testo lungo diviso in schede, SOLO su telefono: sotto i 900px card a scorrimento al posto del paragrafo (che resta su desktop). */
	schedeMobile?: { titolo?: string; html: string }[];
}

const { blocco, fallbackImage, reverse = false, tone = 'dark', compatto = false, sfumoA, dopoSfumo = false, schede = [], fotoCentro = false, schedeMobile = [] } = Astro.props;
// Elenco delle card da mostrare e se valgono solo su telefono.
const soloMobile = schede.length <= 1 && schedeMobile.length > 1;
const elencoSchede = schede.length > 1 ? schede : soloMobile ? schedeMobile : [];
// Nomi delle icone dei punti elenco (IconaChip.astro): con queste il punto diventa un box con icona animata.
const iconeChip = ['manubrio', 'sole', 'goccia', 'lista', 'livelli', 'griglia'];
const mediaAnim = reverse ? 'from-right' : 'from-left';
const textAnim = reverse ? 'from-left' : 'from-right';

const immagini = blocco.immagini?.length ? blocco.immagini : !blocco.video && fallbackImage ? [fallbackImage] : [];
const haMedia = !!blocco.video || immagini.length > 0;
const nomeMedia = blocco.titolo ?? 'della pagina';
// Testo alternativo delle foto: lo indica il blocco (es. le sedi); altrimenti foto decorativa.
const altMedia: string = blocco.alt ?? '';
const accento = tone === 'accento';
// Sfumo in fondo: dal colore del blocco a quello del successivo.
const coloreBlocco = accento ? 'var(--accent)' : tone === 'soft' ? 'var(--bg-dark-soft)' : 'var(--bg-dark)';
const coloreSuccessivo = sfumoA === 'accento' ? 'var(--accent)' : 'var(--bg-dark)';
const sfumo = !!sfumoA && coloreBlocco !== coloreSuccessivo;
---

<section
	id={blocco.id ?? undefined}
	class:list={['cb', 'sez', { 'on-dark': !accento }, `cb--${tone}`, { 'cb--reverse': reverse, 'cb--solo': !haMedia, 'cb--compatto': compatto, 'cb--foto-centro': fotoCentro, 'cb--card-mobile': soloMobile, sfuma: sfumo, 'dopo-sfumo': dopoSfumo }]}
	style={sfumo ? `--da:${coloreBlocco};--a:${coloreSuccessivo}` : undefined}
>
	<div class="cb__grid container-wide">
		{
			haMedia && (
				<div class:list={['cb__media', { 'cb__media--contain': blocco.adattamento === 'contain' }]} data-anim={mediaAnim}>
					{blocco.video ? (
						<>
							<video class="cb__video" src={blocco.video} muted loop playsinline preload="metadata" aria-label={`Video: ${nomeMedia}`} />
							<button type="button" class="cb__vbtn" aria-label="Metti in pausa il video" hidden>
								<svg class="cb__vbtn-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" />
								</svg>
								<svg class="cb__vbtn-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path d="M8 5v14l11-7z" fill="currentColor" />
								</svg>
							</button>
						</>
					) : immagini.length > 1 ? (
						<ImageSlider images={immagini} label={`Foto: ${nomeMedia}`} alt={altMedia} />
					) : (
						<Img src={immagini[0]} alt={altMedia} class="img-cover" sizes="(max-width: 900px) 90vw, 46vw" />
					)}
				</div>
			)
		}

		<div class="cb__text" data-anim={haMedia ? textAnim : 'up'} data-anim-delay="80">
			{blocco.titolo && (
				<SectionTitle tone={accento ? 'on-accent' : 'dark-bg'} flush gap={22}>
					{blocco.titolo}
				</SectionTitle>
			)}


			{
				elencoSchede.length > 1 && (
					<>
						<ul class:list={['cb__schede', { 'cb__schede--mobile': soloMobile }]} data-schede>
							{elencoSchede.map((s, i) => (
								<li class:list={['cb__scheda', { 'is-attiva': i === 0 }]} data-anim="fade" data-anim-delay={String(Math.min(i, 2) * 110)}>
									{s.titolo && <h3 class="cb__scheda-titolo">{s.titolo}</h3>}
									<div class="cb__scheda-testo" set:html={s.html} />
								</li>
							))}
						</ul>
						<div class:list={['cb__punti', { 'cb__punti--mobile': soloMobile }]} aria-hidden="true">
							{elencoSchede.map((_, i) => (
								<span class:list={['cb__punto', { 'is-on': i === 0 }]} />
							))}
							<svg class="cb__scorri" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 12h15" />
								<path d="m13 6 6 6-6 6" />
							</svg>
						</div>
					</>
				)
			}

			{(schede.length <= 1) && <div class:list={['cb__desc', { 'cb__desc--desk': soloMobile }]} set:html={blocco.descrizioneHtml} />}

			{
				blocco.dettagli.length > 0 && (
					<ul class:list={['cb__chips', { 'cb__chips--icone': blocco.dettagli.some((d) => d.icona && iconeChip.includes(d.icona)) }]}>
						{blocco.dettagli.map((d, i) =>
							d.icona && iconeChip.includes(d.icona) ? (
								<li class="cb__chip cb__chip--ico" data-anim="up" data-anim-delay={String(i * 100)}>
									<span class="cb__chip-ico">
										<IconaChip nome={d.icona as any} />
									</span>
									<span>{d.testo.replace(/\u200b/g, '')}</span>
								</li>
							) : (
							<li class="cb__chip">
								{d.icona?.includes('clock') && (
									<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
										<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
										<path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								{d.testo}
							</li>
							)
						)}
					</ul>
				)
			}

			{
				blocco.pulsanti && blocco.pulsanti.length > 0 && (
					<div class="cb__actions">
						{blocco.pulsanti.map((p) => (
							<a
								class="btn"
								href={p.href}
								target={p.esterno ? '_blank' : undefined}
								rel={p.esterno ? 'noopener' : undefined}
							>
								{p.testo}
							</a>
						))}
					</div>
				)
			}

			{
				blocco.extra && (
					<div class="cb__extra">
						<h3 class="cb__h3">{blocco.extra.titolo}</h3>
						<div class="cb__desc" set:html={blocco.extra.html} />
					</div>
				)
			}

			{
				blocco.portare.length > 0 && (
					<div class="cb__bring">
						<h3 class="cb__h3">{blocco.portareTitolo ?? 'Cosa portare'}</h3>
						<ul class="cb__bring-list">
							{blocco.portare.map((p, i) => (
								<li class="cb__bring-item" data-anim="pop" style={`transition-delay:${i * 90}ms`}>
									{p.immagine && <Img src={p.immagine} alt="" sizes="64px" />}
									<span>{p.etichetta}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				blocco.intensita.length > 0 && (
					<div class="cb__bars" data-anim="fade">
						<h3 class="cb__h3">Intensità</h3>
						<ul class="cb__bars-list">
							{blocco.intensita.map((b, i) => (
								<li class="cb__bar" style={`--v:${b.valore / 100};--i:${i}`}>
									<span class="cb__bar-label">{b.etichetta}</span>
									<span
										class="cb__track"
										role="meter"
										aria-label={b.etichetta}
										aria-valuemin="0"
										aria-valuemax="100"
										aria-valuenow={b.valore}
									>
										<span class="cb__fill" />
									</span>
									<span class="cb__bar-val">{b.valore}%</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<slot />
		</div>
	</div>

	{
		Astro.slots.has('orari') && (
			<div class="cb__orari container-wide">
				<slot name="orari" />
			</div>
		)
	}
</section>

<style>
	.cb {
		padding-block: var(--sez-pt, clamp(48px, 7vw, 96px)) var(--sez-pb, clamp(48px, 7vw, 96px));
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.cb--soft {
		background: var(--bg-dark-soft);
	}

	/* ---- Variante giallo: fondo giallo, testo nero ---- */
	.cb--accento {
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__desc,
	.cb--accento .cb__h3 {
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__desc :global(a) {
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__chip {
		border-color: rgba(0, 0, 0, 0.2);
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__chip::before {
		border-color: var(--bg-dark-deep);
	}

	.cb--accento .cb__chip svg {
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__extra {
		background: rgba(0, 0, 0, 0.12);
	}

	.cb--accento .cb__bring-item {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.cb--accento .cb__track {
		background: rgba(0, 0, 0, 0.25);
	}

	.cb--accento .cb__fill {
		background: var(--bg-dark);
	}

	.cb--accento .cb__bar-val {
		color: var(--bg-dark-deep);
	}

	.cb__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: start;
	}

	.cb--reverse .cb__media {
		order: 2;
	}

	/* Senza media: una sola colonna di testo a misura di lettura, allineata a sinistra
	   come il resto della pagina (stesso margine dei titoli e dei blocchi con foto). */
	.cb--solo {
		padding-block: var(--sez-pt, clamp(32px, 4vw, 56px)) var(--sez-pb, clamp(32px, 4vw, 56px));
	}

	.cb--solo .cb__grid {
		grid-template-columns: minmax(0, 60rem);
		justify-content: start;
	}

	.cb--compatto {
		padding-bottom: 0;
	}

	.cb--solo .cb__desc :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Loghi: interi, su fondo bianco, senza il ritaglio dei bordi. */
	.cb__media.cb__media--contain {
		background: #fff;
	}

	.cb__media--contain :global(img) {
		object-fit: contain;
		padding: 6%;
	}

	/* ---- Video / foto ---- */
	/* Il testo e' piu' alto del video: il video resta agganciato sotto l'header
	   mentre si legge. */
	.cb__media {
		position: sticky;
		top: calc(var(--header-h) + 24px);
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		background: var(--bg-dark);
	}

	.cb__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cb__vbtn {
		position: absolute;
		right: 12px;
		bottom: 12px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: var(--text-on-dark);
		cursor: pointer;
		transition: background var(--dur-base);
	}

	.cb__vbtn:hover {
		background: var(--accent);
	}

	.cb__vbtn:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: 2px;
	}

	.cb__vbtn-play {
		display: none;
	}

	.cb__vbtn[data-paused] .cb__vbtn-pause {
		display: none;
	}

	.cb__vbtn[data-paused] .cb__vbtn-play {
		display: block;
	}

	/* ---- Testo ---- */
	.cb__text :global(.st__title) {
		text-transform: uppercase;
	}

	.cb__desc {
		font-size: var(--text-md);
		line-height: 1.7;
		color: var(--text-on-dark);
	}

	.cb__desc :global(p) {
		margin: 0 0 1em;
	}

	/* Anche sotto un elenco puntato lo stesso spazio del paragrafo (prima il testo dopo la lista restava attaccato). */
	.cb__desc :global(ul),
	.cb__desc :global(ol) {
		margin: 0 0 1em;
	}

	.cb__desc :global(ul:last-child),
	.cb__desc :global(ol:last-child) {
		margin-bottom: 0;
	}

	.cb__desc :global(a) {
		color: var(--accent);
	}

	/* Bottoni di collegamento: tutti trasparenti con bordo; giallo sui blocchi scuri, nero su quelli gialli. */
	.cb--accento .cb__actions :global(.btn) {
		--btn-border: var(--on-accent);
		--btn-hover-text: var(--accent);
	}

	.cb__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 24px;
	}

	/* Dettagli: elenco con spunta gialla e filo sottile tra le voci (niente pillole). */
	.cb__chips {
		display: grid;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.cb__chip {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 0;
		border-bottom: 1px solid var(--border-on-dark);
		color: var(--text-on-dark);
		font-size: var(--text-md);
		font-weight: 500;
		line-height: 1.35;
	}

	.cb__chip:first-child {
		border-top: 1px solid var(--border-on-dark);
	}

	/* Spunta disegnata col CSS; le voci con icona (orologio) usano la loro. */
	.cb__chip:not(:has(svg))::before {
		content: '';
		flex: none;
		width: 6px;
		height: 12px;
		margin: 0 6px 3px 4px;
		border: solid var(--accent);
		border-width: 0 3px 3px 0;
		transform: rotate(45deg);
	}

	.cb__chip svg {
		flex: none;
		color: var(--accent);
	}

	/* Punti elenco con icona animata (gym floor): sotto le card, due colonne su desktop. Box giallo con icona nera sui
	   blocchi neri, box nero con icona gialla su quelli gialli; niente filetti. */
	.cb__chips--icone {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 16px;
		margin-top: 20px;
	}

	.cb__chip--ico,
	.cb__chip--ico:first-child {
		border: 0;
		padding: 0;
		font-size: var(--text-base);
	}

	.cb__chip-ico {
		display: grid;
		place-items: center;
		flex: none;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: var(--accent);
		color: var(--bg-dark-deep);
	}

	.cb--accento .cb__chip-ico {
		background: var(--bg-dark-deep);
		color: var(--accent);
	}

	.cb__chip-ico :global(svg) {
		width: 24px;
		height: 24px;
		color: inherit;
	}

	@media (max-width: 560px) {
		.cb__chips--icone {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.cb__extra {
		margin-top: 28px;
		padding: 22px 24px 8px;
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
	}

	.cb--soft .cb__extra {
		background: var(--bg-dark);
	}

	.cb__h3 {
		margin: 0 0 14px;
		font-size: var(--text-base);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-on-dark);
	}

	/* ---- Cosa portare ---- */
	.cb__bring {
		margin-top: 32px;
	}

	.cb__bring-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cb__bring-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		min-width: 0;
		overflow-wrap: anywhere;
		hyphens: auto;
		padding: 16px 8px;
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-align: center;
	}

	.cb--soft .cb__bring-item {
		background: var(--bg-dark);
	}

	.cb__bring-item :global(img) {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	/* ---- Intensita' ---- */
	.cb__bars {
		margin-top: 32px;
	}

	.cb__bars-list {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cb__bar {
		display: grid;
		grid-template-columns: 7.5rem 1fr 3rem;
		align-items: center;
		gap: 14px;
		font-size: var(--text-base);
		font-weight: 700;
	}

	.cb__bar-val {
		text-align: right;
		color: var(--text-on-dark);
	}

	.cb__track {
		display: block;
		height: 10px;
		overflow: hidden;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.18);
	}

	.cb__fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(var(--v));
		transform-origin: left;
	}

	/* La barra si riempie quando il blocco entra in vista (solo con JS e
	   senza richiesta di ridurre il movimento: altrimenti e' gia' piena). */
	@media (prefers-reduced-motion: no-preference) {
		:global(.js) .cb__fill {
			transform: scaleX(0);
			transition: transform 1.2s var(--ease-out-crit) calc(var(--i) * 150ms + 250ms);
		}

		:global(.js) .cb__bars.is-visible .cb__fill {
			transform: scaleX(var(--v));
		}
	}

	@media (max-width: 900px) {
		.cb__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		/* Su una colonna il video sta sempre sopra al testo. */
		.cb--reverse .cb__media {
			order: 0;
		}

		.cb__media {
			position: relative;
			top: auto;
		}
	}

	/* ---- Pagine sede (ambienti): foto tra titolo e paragrafo, piu' evidente; paragrafo meno grande ---- */
	.cb--foto-centro .cb__media {
		aspect-ratio: 4 / 3;
	}

	.cb--foto-centro .cb__desc {
		font-size: var(--text-base);
		line-height: 1.6;
	}

	/* Schede: card gialle con testo nero sui blocchi neri, card nere con titolo giallo e testo bianco sui
	   blocchi gialli. Desktop: griglia a due colonne; telefono: card affiancate da scorrere (vedi sotto). */
	.cb__schede {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cb__scheda {
		position: relative;
		padding: 18px 18px 22px;
		border-radius: 16px;
		background: var(--accent);
		color: var(--on-accent);
		box-shadow: 0 14px 28px -16px rgba(0, 0, 0, 0.55);
		transition:
			scale 0.45s var(--ease-out-crit),
			translate 0.35s var(--ease-out-crit),
			box-shadow 0.35s ease;
	}

	@media (hover: hover) and (min-width: 901px) {
		.cb__scheda:hover {
			translate: 0 -4px;
			box-shadow: 0 22px 34px -16px rgba(0, 0, 0, 0.6);
		}
	}

	.cb--accento .cb__scheda {
		background: var(--bg-dark-deep);
		color: var(--text-on-dark);
	}

	.cb__scheda-titolo {
		margin: 0 0 8px;
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.2;
		text-transform: uppercase;
		color: inherit;
	}

	.cb--accento .cb__scheda-titolo {
		color: var(--accent);
	}

	/* Sottolineatura sotto il titolo (nera sulle card gialle, gialla su quelle nere) che si disegna quando la
	   card compare. */
	.cb__scheda-titolo::after {
		content: '';
		display: block;
		width: 32px;
		height: 3px;
		margin-top: 8px;
		background: currentColor;
		transform-origin: left;
	}

	:global(.js) .cb__scheda-titolo::after {
		transform: scaleX(0);
		transition: transform 0.6s var(--ease-out-crit) 0.35s;
	}

	:global(.js) .cb__scheda:global(.is-visible) .cb__scheda-titolo::after {
		transform: scaleX(1);
	}

	.cb__scheda-testo {
		font-size: var(--text-base);
		line-height: 1.5;
	}

	.cb__scheda-testo :global(p) {
		margin: 0 0 0.6em;
	}

	.cb__scheda-testo :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Elenchi puntati dentro una card (es. "Benefici principali"). */
	.cb__scheda-testo :global(ul),
	.cb__scheda-testo :global(ol) {
		margin: 0 0 0.9em;
		padding-left: 1.2em;
	}

	.cb__scheda-testo :global(ul:last-child),
	.cb__scheda-testo :global(ol:last-child) {
		margin-bottom: 0;
	}

	.cb__scheda-testo :global(li) {
		margin: 0 0 0.45em;
	}

	.cb__scheda-testo :global(li:last-child) {
		margin-bottom: 0;
	}

	/* Il grassetto su fondo scuro e' giallo (.on-dark strong): dentro la card gialla resterebbe invisibile. */
	.cb__scheda :global(strong) {
		color: inherit;
	}

	.cb__punti {
		display: none;
	}

	/* Card solo su telefono: su desktop restano il paragrafo originale e nessuna card. */
	.cb__schede--mobile,
	.cb__punti--mobile {
		display: none;
	}

	@media (max-width: 900px) {
		/* Il contenitore del testo si "scioglie" cosi' la foto puo' stare tra titolo e paragrafo: titolo (0), foto (1),
		   tutto il resto (2). Le voci hanno 24px di distanza dalla foto, non il gap della griglia. */
		.cb .cb__grid {
			gap: 0;
		}

		.cb .cb__text {
			display: contents;
		}

		.cb .cb__text > :global(*) {
			order: 2;
		}

		.cb .cb__text > :global(.st) {
			order: 0;
		}

		/* Card affiancate che si scorrono col dito: se ne vede una e un pezzo della successiva. La fila arriva ai
		   bordi dello schermo (margini negativi pari al margine laterale) senza allargare la pagina. */
		.cb__schede {
			display: flex;
			gap: 12px;
			margin-inline: calc(-1 * var(--gutter));
			padding: 4px var(--gutter) 12px;
			/* Solo orizzontale: con overflow-x:auto il browser rende scorrevole anche la verticale e la fila
			   "catturava" il dito che voleva scorrere la pagina. pan-y lascia lo scorrimento verticale alla pagina,
			   overscroll-behavior evita che lo scorrimento laterale passi alla pagina (o al "torna indietro"). */
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			touch-action: pan-x pan-y;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--gutter);
			scrollbar-width: none;
		}

		.cb__schede::-webkit-scrollbar {
			display: none;
		}

		/* La card in vista e' a grandezza piena, le altre un po' piu' piccole (si sente lo scorrimento).
		   "scale" e non "transform", che serve all'animazione di entrata. */
		.cb__scheda {
			flex: 0 0 78%;
			scroll-snap-align: start;
			scale: 0.93;
			transform-origin: left center;
		}

		.cb__scheda.is-attiva {
			scale: 1;
		}

		.cb__punti {
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 8px;
			margin-top: 6px;
		}

		/* Freccia che invita a scorrere: oscilla verso destra e sparisce all'ultima card. */
		.cb__scorri {
			margin-left: 6px;
			animation: cb-scorri 1.4s ease-in-out infinite;
			transition: opacity 0.3s ease;
		}

		.cb__punti.is-fine .cb__scorri {
			opacity: 0;
			animation: none;
		}

		@keyframes cb-scorri {
			0%,
			100% {
				transform: translateX(-2px);
			}
			50% {
				transform: translateX(5px);
			}
		}

		.cb__punto {
			width: 8px;
			height: 8px;
			border-radius: 4px;
			background: currentColor;
			opacity: 0.3;
			transition: width 0.3s ease, opacity 0.3s ease;
		}

		.cb__punto.is-on {
			width: 22px;
			opacity: 1;
		}

		.cb .cb__media,
		.cb.cb--reverse .cb__media {
			order: 1;
			aspect-ratio: 4 / 3;
			margin: 4px 0 24px;
			box-shadow: 0 18px 36px -18px rgba(0, 0, 0, 0.55);
		}

		/* Paragrafo a 16px (era 18,4). */
		.cb .cb__desc {
			font-size: var(--text-base);
			line-height: 1.6;
		}

		/* Card solo mobile: visibili qui, e il paragrafo originale (per desktop) si nasconde. */
		.cb__schede.cb__schede--mobile {
			display: flex;
		}

		.cb__punti.cb__punti--mobile {
			display: flex;
		}

		.cb__desc--desk {
			display: none;
		}
	}

	@media (max-width: 560px) {
		/* Cosa portare: due colonne (con tre le etichette lunghe, come "cardio frequenzimetro", uscivano dal riquadro). */
		.cb__bring-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.cb__bring-item {
			letter-spacing: 0.05em;
		}

		.cb__bar {
			grid-template-columns: 6rem 1fr 2.6rem;
			gap: 10px;
		}
	}
</style>

<script>
	import { iniziaCarosello } from '../lib/carosello.client';

	// Card a scorrimento: pallino e card attivi seguono lo scorrimento.
	document.querySelectorAll<HTMLElement>('[data-schede]').forEach(iniziaCarosello);

	// Il video parte (muto, in loop) solo quando e' in vista e si ferma quando
	// esce: ne servono diversi per pagina e pesano parecchio. Chi chiede meno
	// movimento non lo vede partire da solo e ha i comandi nativi. Il bottone
	// di pausa permette comunque di fermarlo (e resta fermo).
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.cb__media').forEach((media) => {
		const video = media.querySelector<HTMLVideoElement>('.cb__video');
		if (!video) return;

		if (reduce) {
			video.controls = true;
			return;
		}

		const btn = media.querySelector<HTMLButtonElement>('.cb__vbtn');
		let fermoDaUtente = false;

		if (btn) {
			btn.hidden = false;
			btn.addEventListener('click', () => {
				fermoDaUtente = !fermoDaUtente;
				btn.toggleAttribute('data-paused', fermoDaUtente);
				btn.setAttribute('aria-label', fermoDaUtente ? 'Riprendi il video' : 'Metti in pausa il video');
				if (fermoDaUtente) video.pause();
				else video.play().catch(() => {});
			});
		}

		new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting && !fermoDaUtente) video.play().catch(() => {});
				else video.pause();
			},
			{ threshold: 0.4 }
		).observe(media);
	});
</script>
