---
/*
 * Domande frequenti come elenco a fisarmonica (<details>: funziona anche senza JS
 * e da tastiera). Mostra solo le domande che hanno una risposta: nel sito
 * originale le risposte erano ancora segnaposto, e un testo finto non si pubblica.
 * Se non ce n'e' nessuna, il componente non scrive nulla.
 */
import SectionTitle from './SectionTitle.astro';

interface Props {
	faq: { domanda: string; risposta: string | null }[];
}

const voci = Astro.props.faq.filter((f) => f.risposta);
---

{
	voci.length > 0 && (
		<section class="faq on-dark">
			<SectionTitle tone="dark-bg" accent="frequenti" gap={32}>
				Domande
			</SectionTitle>
			<div class="faq__list container-wide" data-anim="up">
				{voci.map((f) => (
					<details class="faq__item">
						<summary>{f.domanda}</summary>
						<div class="faq__answer" set:html={f.risposta} />
					</details>
				))}
			</div>
		</section>
	)
}

<style>
	.faq {
		padding-block: clamp(48px, 7vw, 96px);
		background: var(--bg-dark);
		border-top: 1px solid var(--border-on-dark);
		color: var(--text-on-dark);
	}

	.faq__list {
		display: grid;
		gap: 12px;
		max-width: 56rem;
	}

	.faq__item {
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
	}

	.faq__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 22px;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}

	.faq__item summary::-webkit-details-marker {
		display: none;
	}

	.faq__item summary::after {
		content: '+';
		flex: none;
		font-size: 1.6rem;
		line-height: 1;
		color: var(--accent);
		transition: transform var(--dur-base) var(--ease-out-crit);
	}

	.faq__item[open] summary::after {
		transform: rotate(45deg);
	}

	.faq__item summary:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}

	.faq__answer {
		padding: 0 22px 20px;
		line-height: 1.7;
		color: var(--text-on-dark);
	}

	.faq__answer :global(p) {
		margin: 0 0 0.8em;
	}
</style>
