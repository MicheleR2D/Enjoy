# URL pubblico del sito in produzione (usato per canonical URL e sitemap)
SITE_URL=https://enjoyclub.eu

# Consenso cookie (CookieYes) - ID cliente del banner. Da recuperare dalla dashboard CookieYes
# del sito attuale (il banner e' gia' attivo su enjoyclub.eu).
PUBLIC_COOKIEYES_ID=

# Google Tag Manager / GA4 - da recuperare da wp-admin/Google Site Kit prima del lancio
PUBLIC_GTM_ID=

# Meta Pixel (ID pubblico) - da recuperare da wp-admin prima del lancio, se il sito lo usa
PUBLIC_META_PIXEL_ID=
